{%- comment -%}
  Drawer global do carrinho. Os itens são carregados e atualizados pela
  Cart AJAX API em assets/carrinho.js. Configurações: Theme settings > Carrinho.
{%- endcomment -%}

{%- if settings.cart_type == 'drawer' -%}
  <div
    id="carrinho"
    class="cart-drawer"
    data-cart-drawer
    data-title="{{ settings.cart_drawer_title | default: 'Seu carrinho' | escape }}"
    data-empty-text="{{ settings.cart_drawer_empty_text | default: 'Seu carrinho está vazio.' | escape }}"
    data-continue-label="{{ settings.cart_drawer_continue_label | default: 'Continuar comprando' | escape }}"
    data-checkout-label="{{ settings.cart_drawer_checkout_label | default: 'Finalizar compra' | escape }}"
    data-subtotal-label="Subtotal"
    data-remove-label="Remover"
    data-loading-label="Atualizando carrinho..."
    data-error-label="Não foi possível atualizar o carrinho. Tente novamente."
    data-show-note="{{ settings.cart_show_note }}"
    data-free-shipping-enabled="{{ settings.cart_drawer_show_free_shipping }}"
    data-free-shipping-goal="{{ settings.cart_drawer_free_shipping_goal | default: 300 | times: 100 }}"
    hidden
  >
    <button class="cart-drawer__overlay" type="button" data-cart-drawer-close aria-label="Fechar carrinho"></button>
    <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
      <header class="cart-drawer__header">
        <div>
          <span class="cart-drawer__eyebrow">MINHA SACOLA</span>
          <h2 class="cart-drawer__title" id="CartDrawerTitle">{{ settings.cart_drawer_title | default: 'Seu carrinho' | escape }}</h2>
        </div>
        <button class="cart-drawer__close tap-target" type="button" data-cart-drawer-close aria-label="Fechar carrinho">
          {% render 'icon', name: 'close' %}
        </button>
      </header>

      <div class="cart-drawer__status" role="status" aria-live="polite"></div>
      <div class="cart-drawer__body" data-cart-drawer-content></div>
    </aside>
  </div>

  <style>
    .cart-drawer[hidden] { display: none; }
    .cart-drawer { position: fixed; inset: 0; z-index: 1000; }
    .cart-drawer__overlay {
      position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0;
      background: rgba(11, 29, 58, 0.58); opacity: 0; transition: opacity 0.25s ease;
    }
    .cart-drawer__panel {
      position: absolute; top: 0; right: 0; display: flex; flex-direction: column;
      width: min(460px, 100%); height: 100%; background: var(--color-background);
      color: var(--color-text); box-shadow: -12px 0 36px rgba(11, 29, 58, 0.2);
      transform: translateX(100%); transition: transform 0.3s ease; outline: none;
    }
    .cart-drawer.is-open .cart-drawer__overlay { opacity: 1; }
    .cart-drawer.is-open .cart-drawer__panel { transform: translateX(0); }
    .cart-drawer__header {
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 22px 24px; color: #fff; background: #0B1D3A;
      border-radius: 0 0 0 24px;
    }
    .cart-drawer__eyebrow { display: block; margin-bottom: 3px; color: #E8A817; font-size: var(--f0); font-weight: 700; letter-spacing: .12em; }
    .cart-drawer__title { margin: 0; color: #fff; font-family: 'Bungee', sans-serif; font-size: var(--f4); font-weight: 400; }
    .cart-drawer__close { flex: 0 0 auto; color: #fff; background: rgba(255,255,255,.12); border: 0; border-radius: 12px; }
    .cart-drawer__close svg { width: 20px; height: 20px; }
    .cart-drawer__status { min-height: 0; padding: 0 24px; color: var(--color-accent); font-size: var(--f1); }
    .cart-drawer__status:not(:empty) { padding-top: 12px; }
    .cart-drawer__body { display: flex; flex: 1; min-height: 0; flex-direction: column; }
    .cart-drawer__items { flex: 1; overflow-y: auto; padding: 18px 20px; }
    .cart-drawer__item {
      display: grid; grid-template-columns: 88px 1fr; gap: 14px; margin-bottom: 14px;
      padding: 12px; background: var(--color-background-contrast); border: 1px solid var(--color-border);
      border-radius: 16px;
    }
    .cart-drawer__image { display: block; width: 88px; height: 108px; object-fit: cover; background: #fff; border-radius: 12px; }
    .cart-drawer__item-info { min-width: 0; display: flex; flex-direction: column; }
    .cart-drawer__item-title { color: var(--color-text); font-weight: 700; line-height: 1.3; text-decoration: none; }
    .cart-drawer__variant { margin: 4px 0 0; font-size: var(--f0); opacity: .7; }
    .cart-drawer__item-price { margin: 8px 0; color: var(--color-text); font-family: 'Bungee', sans-serif; font-size: var(--f1); }
    .cart-drawer__item-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; }
    .cart-drawer__quantity { display: inline-flex; align-items: center; overflow: hidden; border: 1px solid var(--color-border); border-radius: 10px; background: #fff; }
    .cart-drawer__quantity button { width: 34px; height: 34px; padding: 0; color: var(--color-text); background: transparent; border: 0; font-size: 1.15rem; }
    .cart-drawer__quantity span { min-width: 30px; text-align: center; font-weight: 700; }
    .cart-drawer__remove { padding: 6px 0; color: var(--color-accent); background: none; border: 0; font-size: var(--f0); text-decoration: underline; }
    .cart-drawer__footer { padding: 18px 24px 24px; border-top: 1px solid var(--color-border); background: #fff; box-shadow: 0 -8px 24px rgba(11,29,58,.06); }
    .cart-drawer__shipping { margin-bottom: 14px; }
    .cart-drawer__shipping-text { margin: 0 0 7px; font-size: var(--f1); }
    .cart-drawer__shipping-bar { height: 8px; overflow: hidden; background: var(--color-background-contrast); border-radius: 99px; }
    .cart-drawer__shipping-progress { display: block; height: 100%; background: #E8A817; border-radius: inherit; transition: width .3s ease; }
    .cart-drawer__subtotal { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; font-weight: 700; }
    .cart-drawer__subtotal strong { font-family: 'Bungee', sans-serif; font-weight: 400; }
    .cart-drawer__tax-note { margin: 0 0 14px; font-size: var(--f0); opacity: .65; }
    .cart-drawer__note { width: 100%; min-height: 68px; margin: 0 0 14px; resize: vertical; border-radius: 10px; }
    .cart-drawer__buttons { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .cart-drawer__buttons .button { width: 100%; padding-inline: 12px; border-radius: 10px; font-size: var(--f1); text-align: center; }
    .cart-drawer button.button--secondary {
      color: var(--color-text, #0B1D3A);
      background: transparent;
      border-color: var(--color-text, #0B1D3A);
      transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
    }
    .cart-drawer button.button--secondary:hover {
      color: var(--color-accent-text, #fff);
      background: var(--color-text, #0B1D3A);
      opacity: 1;
    }
    .cart-drawer__checkout { background: var(--color-accent); }
    .cart-drawer__empty { display: grid; flex: 1; place-content: center; padding: 40px 24px; text-align: center; }
    .cart-drawer__empty-icon { margin: 0 auto 16px; color: #0B1D3A; }
    .cart-drawer__empty-icon svg { width: 54px; height: 54px; }
    .cart-drawer__empty h3 { margin: 0 0 8px; font-family: 'Bungee', sans-serif; font-weight: 400; }
    .cart-drawer__empty p { margin: 0 0 20px; opacity: .7; }
    body.cart-drawer-open { overflow: hidden; }
    @media (max-width: 520px) {
      .cart-drawer__header { padding: 18px 16px; }
      .cart-drawer__items { padding: 14px 12px; }
      .cart-drawer__footer { padding: 16px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cart-drawer__overlay, .cart-drawer__panel, .cart-drawer__shipping-progress { transition: none; }
      .cart-drawer button.button--secondary { transition: none; }
    }
  </style>
{%- else -%}
  <div id="carrinho" hidden></div>
{%- endif -%}
