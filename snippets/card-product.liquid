{% doc %}
Renders a product card with purchase or restock actions.

@param {product} card_product - Product displayed in the card.
{% enddoc %}
{%- liquid
  assign ratio = 1
  assign purchasable_variant = nil
  case settings.card_image_ratio
    when 'portrait'
      assign ratio = 0.75
    when 'square'
      assign ratio = 1
    when 'adapt'
      if card_product.featured_media
        assign ratio = card_product.featured_media.aspect_ratio
      endif
  endcase

  for variant in card_product.variants
    if variant.available
      if variant.inventory_management == blank or variant.inventory_quantity > 0
        assign purchasable_variant = variant
        break
      endif
    endif
  endfor
-%}
<div class="card-product">
  <a href="{{ card_product.url }}" class="card-product__link">
    <div class="card-product__media" style="padding-bottom: {{ 1 | divided_by: ratio | times: 100 }}%;">
      {%- if card_product.featured_media -%}
        {{
          card_product.featured_media
          | image_url: width: 720
          | image_tag:
            loading: 'lazy',
            class: 'card-product__image card-product__image--primary',
            widths: '180, 360, 540, 720',
            sizes: '(min-width: 1000px) 25vw, 50vw',
            alt: card_product.featured_media.alt | default: card_product.title | escape
        }}
        {%- if settings.card_show_second_image and card_product.media[1] -%}
          {{
            card_product.media[1]
            | image_url: width: 720
            | image_tag:
              loading: 'lazy',
              class: 'card-product__image card-product__image--secondary',
              widths: '180, 360, 540, 720',
              sizes: '(min-width: 1000px) 25vw, 50vw',
              alt: card_product.media[1].alt | default: card_product.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        <div class="card-product__placeholder-img">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,0.15)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </div>
      {%- endif -%}

      {%- if card_product.compare_at_price > card_product.price and purchasable_variant != nil -%}
        <span class="card-product__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif purchasable_variant == nil -%}
        <span class="card-product__badge card-product__badge--sold-out">{{ 'products.product.restock_badge' | t }}</span>
      {%- endif -%}
    </div>

    <div class="card-product__info">
      {%- if settings.card_show_vendor and card_product.vendor != blank -%}
        <span class="card-product__vendor">{{ card_product.vendor }}</span>
      {%- endif -%}
      <h3 class="card-product__title">{{ card_product.title | escape }}</h3>
      <div class="card-product__price-row">
        {% render 'price', product: card_product, use_variant: false, show_compare: true, price_class: 'price--card' %}
      </div>
    </div>
  </a>

  <div class="card-product__add-form">
    {%- if purchasable_variant != nil -%}
      <form method="post" action="{{ routes.cart_add_url }}" style="margin:0;">
        <input type="hidden" name="id" value="{{ purchasable_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="card-product__add-btn" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ card_product.title | escape }}">
          <span>{{ 'products.product.add_to_cart' | t }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
        </button>
      </form>
    {%- else -%}
      {%- if request.page_type == 'product' -%}
        <a
          href="{{ card_product.url }}"
          class="card-product__add-btn card-product__add-btn--restock"
          aria-label="{{ 'products.product.view_full_details' | t }}: {{ card_product.title | escape }}">
          <span>{{ 'products.product.view_full_details' | t }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      {%- else -%}
        <div
          class="card-product__restock-app ecomsend-bis-block"
          data-product-id="{{ card_product.id }}"
          data-restock-card
          data-restock-label="{{ 'products.product.restock_signup' | t | escape }}"
          data-restock-loading="{{ 'products.product.restock_loading' | t | escape }}"
          data-restock-error="{{ 'products.product.restock_error' | t | escape }}">
          <button
            type="button"
            class="card-product__add-btn card-product__add-btn--restock"
            data-restock-card-trigger
            aria-label="{{ 'products.product.restock_signup_aria' | t: product: card_product.title | escape }}">
            <span>{{ 'products.product.restock_signup' | t }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
          </button>
          <span class="visually-hidden" data-restock-card-status aria-live="polite"></span>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% javascript %}
  (function () {
    if (window.dogoRestockCardsInitialized) return;
    window.dogoRestockCardsInitialized = true;

    function appButton(card) {
      return card.querySelector('.email-me-inlineButton');
    }

    function syncCard(card) {
      var button = appButton(card);
      if (!button) return;

      var label = card.dataset.restockLabel;
      if (button.textContent.trim() !== label) button.textContent = label;
      if (button.getAttribute('aria-label') !== label) button.setAttribute('aria-label', label);
      if (!button.classList.contains('card-product__add-btn')) button.classList.add('card-product__add-btn');
      if (button.getAttribute('role') !== 'button') button.setAttribute('role', 'button');
      if (button.tabIndex !== 0) button.tabIndex = 0;

      var trigger = card.querySelector('[data-restock-card-trigger]');
      var isReady = window.getComputedStyle(button).display !== 'none';
      if (trigger && trigger.hidden !== isReady) trigger.hidden = isReady;
    }

    function syncCards() {
      document.querySelectorAll('[data-restock-card]').forEach(syncCard);
    }

    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-restock-card-trigger]');
      if (!trigger) return;
      event.preventDefault();

      var card = trigger.closest('[data-restock-card]');
      var status = card.querySelector('[data-restock-card-status]');
      var attempts = 0;
      trigger.setAttribute('aria-busy', 'true');
      if (status) status.textContent = card.dataset.restockLoading;

      function openForm() {
        var button = appButton(card);
        if (button && window.getComputedStyle(button).display !== 'none') {
          trigger.removeAttribute('aria-busy');
          if (status) status.textContent = '';
          button.click();
          return;
        }

        attempts += 1;
        if (attempts < 40) {
          window.setTimeout(openForm, 200);
          return;
        }

        trigger.removeAttribute('aria-busy');
        if (status) status.textContent = card.dataset.restockError;
      }

      openForm();
    });

    document.addEventListener('keydown', function (event) {
      var button = event.target.closest('[data-restock-card] .email-me-inlineButton');
      if (!button || (event.key !== 'Enter' && event.key !== ' ')) return;
      event.preventDefault();
      button.click();
    });

    new MutationObserver(syncCards).observe(document.body, {
      attributes: true,
      childList: true,
      subtree: true
    });
    syncCards();
  })();
{% endjavascript %}
