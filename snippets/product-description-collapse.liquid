{%- comment -%}
  ============================================================
  product-description-collapse — descrição sob a galeria
  ============================================================

  O QUE FAZ:
  Exibe a descrição do produto abaixo da galeria, colapsada,
  com botão "Ver mais" / "Ver menos" para expandir o conteúdo.

  COMO USAR:
  {% render 'product-description-collapse',
    product: product,
    section_id: section.id,
    show: section.settings.show_description_under_media,
    more_label: section.settings.description_more_label,
    less_label: section.settings.description_less_label
  %}

  PARÂMETROS:
  - product, section_id
  - show: boolean
  - more_label / less_label: textos do botão
{%- endcomment -%}

{%- if show and product.description != blank -%}
  {%- liquid
    assign more_txt = more_label | default: 'Ver mais'
    assign less_txt = less_label | default: 'Ver menos'
  -%}
  <div class='pmd' id='ProductMediaDesc-{{ section_id }}'>
    <div
      class='pmd__body rte is-collapsed'
      id='ProductMediaDescBody-{{ section_id }}'>
      {{ product.description }}
    </div>
    <button
      type='button'
      class='pmd__toggle'
      id='ProductMediaDescToggle-{{ section_id }}'
      aria-expanded='false'
      aria-controls='ProductMediaDescBody-{{ section_id }}'
      hidden>
      <span class='pmd__toggle-label' data-more='{{ more_txt | escape }}' data-less='{{ less_txt | escape }}'>
        {{- more_txt | escape -}}
      </span>
      <svg class='pmd__toggle-icon' width='14' height='14' viewBox='0 0 16 16' fill='none' aria-hidden='true'>
        <path d='m4 6 4 4 4-4' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>
      </svg>
    </button>
  </div>

  <style>
    .pmd {
      margin-top: 20px;
      width: 100%;
    }
    .pmd__body {
      font-size: var(--f1);
      line-height: 1.6;
      color: var(--color-text);
      position: relative;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }
    .pmd__body.is-collapsed {
      max-height: 7.2em;
    }
    .pmd__body.is-collapsed::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2.8em;
      background: linear-gradient(to bottom, transparent, var(--color-background, #fff));
      pointer-events: none;
    }
    .pmd__body.is-expanded {
      max-height: none;
    }
    .pmd__body.is-expanded::after {
      display: none;
    }
    .pmd__toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-accent);
      font-size: var(--f1);
      font-weight: var(--font-heading-weight);
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .pmd__toggle:hover {
      opacity: 0.8;
    }
    .pmd__toggle:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }
    .pmd__toggle-icon {
      transition: transform 0.25s ease;
      flex-shrink: 0;
    }
    .pmd__toggle[aria-expanded='true'] .pmd__toggle-icon {
      transform: rotate(180deg);
    }
    .pmd__toggle[hidden] {
      display: none;
    }
  </style>

  <script>
    ;(function () {
      var root = document.getElementById('ProductMediaDesc-{{ section_id }}')
      if (!root) return
      var body = document.getElementById('ProductMediaDescBody-{{ section_id }}')
      var btn = document.getElementById('ProductMediaDescToggle-{{ section_id }}')
      if (!body || !btn) return

      var label = btn.querySelector('.pmd__toggle-label')
      var moreTxt = label ? label.getAttribute('data-more') : 'Ver mais'
      var lessTxt = label ? label.getAttribute('data-less') : 'Ver menos'
      var collapsedMax = 0

      function measure() {
        var wasExpanded = body.classList.contains('is-expanded')
        body.classList.add('is-collapsed')
        body.classList.remove('is-expanded')
        collapsedMax = parseFloat(window.getComputedStyle(body).maxHeight) || 0
        var needsToggle = body.scrollHeight > collapsedMax + 4
        btn.hidden = !needsToggle
        if (!needsToggle) {
          body.classList.remove('is-collapsed')
          body.classList.add('is-expanded')
          btn.setAttribute('aria-expanded', 'false')
          if (label) label.textContent = moreTxt
          return
        }
        if (wasExpanded) {
          body.classList.remove('is-collapsed')
          body.classList.add('is-expanded')
          btn.setAttribute('aria-expanded', 'true')
          if (label) label.textContent = lessTxt
        } else {
          btn.setAttribute('aria-expanded', 'false')
          if (label) label.textContent = moreTxt
        }
      }

      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true'
        if (expanded) {
          body.classList.add('is-collapsed')
          body.classList.remove('is-expanded')
          btn.setAttribute('aria-expanded', 'false')
          if (label) label.textContent = moreTxt
        } else {
          body.classList.remove('is-collapsed')
          body.classList.add('is-expanded')
          btn.setAttribute('aria-expanded', 'true')
          if (label) label.textContent = lessTxt
        }
      })

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', measure)
      } else {
        measure()
      }
      window.addEventListener('resize', measure)
    })()
  </script>
{%- endif -%}
