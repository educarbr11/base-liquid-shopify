{%- comment -%}
  ============================================================
  product-description-collapse — descrição sob a galeria
  ============================================================

  O QUE FAZ:
  Exibe a descrição do produto abaixo da galeria, colapsada,
  com botão "Ver mais" / "Ver menos" para expandir o conteúdo.

  COMO USAR:
  {% render 'product-description-collapse',
    product: product,
    section_id: section.id,
    show: section.settings.show_description_under_media,
    more_label: section.settings.description_more_label,
    less_label: section.settings.description_less_label
  %}

  PARÂMETROS:
  - product, section_id
  - show: boolean
  - more_label / less_label: textos do botão
{%- endcomment -%}

{%- if show and product.description != blank -%}
  {%- liquid
    assign more_txt = more_label | default: 'Ver mais'
    assign less_txt = less_label | default: 'Ver menos'
  -%}
  <div class='pmd' id='ProductMediaDesc-{{ section_id }}'>
    <input
      type='checkbox'
      class='pmd__state visually-hidden'
      id='ProductMediaDescState-{{ section_id }}'
      aria-controls='ProductMediaDescBody-{{ section_id }}'>
    <div
      class='pmd__body rte is-collapsed'
      id='ProductMediaDescBody-{{ section_id }}'>
      {{ product.description }}
    </div>
    <label
      class='pmd__toggle'
      for='ProductMediaDescState-{{ section_id }}'>
      <span class='pmd__toggle-more'>{{ more_txt | escape }}</span>
      <span class='pmd__toggle-less'>{{ less_txt | escape }}</span>
      <svg class='pmd__toggle-icon' width='14' height='14' viewBox='0 0 16 16' fill='none' aria-hidden='true'>
        <path d='m4 6 4 4 4-4' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>
      </svg>
    </label>
  </div>

  <style>
    .pmd {
      margin-top: 20px;
      width: 100%;
    }
    .pmd__body {
      font-size: var(--f1);
      line-height: 1.6;
      color: var(--color-text);
      position: relative;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }
    .pmd__body.is-collapsed {
      max-height: 7.2em;
    }
    .pmd__body.is-collapsed::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2.8em;
      background: linear-gradient(to bottom, transparent, var(--color-background, #fff));
      pointer-events: none;
    }
    .pmd__state:checked ~ .pmd__body {
      max-height: none;
      overflow: visible;
    }
    .pmd__state:checked ~ .pmd__body::after {
      display: none;
    }
    .pmd__toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-accent);
      font-size: var(--f1);
      font-weight: var(--font-heading-weight);
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .pmd__toggle-less {
      display: none;
    }
    .pmd__state:checked ~ .pmd__toggle .pmd__toggle-more {
      display: none;
    }
    .pmd__state:checked ~ .pmd__toggle .pmd__toggle-less {
      display: inline;
    }
    .pmd__toggle:hover {
      opacity: 0.8;
    }
    .pmd__toggle:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }
    .pmd__state:focus-visible ~ .pmd__toggle {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }
    .pmd__toggle-icon {
      transition: transform 0.25s ease;
      flex-shrink: 0;
    }
    .pmd__state:checked ~ .pmd__toggle .pmd__toggle-icon {
      transform: rotate(180deg);
    }
  </style>
{%- endif -%}
