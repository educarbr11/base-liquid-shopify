{% doc %}
Renders an inline shipping calculator using the Shopify cart shipping rates API.

@param {object} block - Freight block with labels configured in the theme editor.
@param {string} section_id - Main product section identifier.
{% enddoc %}

<div class="pf" id="ProductFreight-{{ section_id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}
    <p class="pf__title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      {{- block.settings.title | escape -}}
    </p>
  {%- endif -%}

  <div class="pf__form" id="FreightForm-{{ section_id }}">
    <div class="pf__input-row">
      <label class="visually-hidden" for="FreightCep-{{ section_id }}">{{ 'sections.product.freight.cep_label' | t | default: 'CEP' }}</label>
      <input
        type="text"
        id="FreightCep-{{ section_id }}"
        class="pf__input"
        placeholder="{{ block.settings.placeholder | default: '00000-000' | escape }}"
        maxlength="9"
        inputmode="numeric"
        autocomplete="postal-code"
        aria-describedby="FreightResult-{{ section_id }}"
      >
      <button type="button" class="pf__btn button button--small">
        {{ block.settings.button_label | default: 'Calcular' | escape }}
      </button>
    </div>
    <div id="FreightResult-{{ section_id }}" class="pf__result" aria-live="polite" aria-atomic="true"></div>
  </div>

  <a
    href="https://buscacepinter.correios.com.br/app/endereco/index.php"
    target="_blank"
    rel="noopener noreferrer"
    class="pf__link"
    aria-label="{{ 'sections.product.freight.find_cep_aria' | t | default: 'Não sei meu CEP — abre em nova aba' }}"
  >
    {{ block.settings.link_label | default: 'Não sei meu CEP' | escape }}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
  </a>
</div>

<style>
  /* ── Product Freight ── */
  .pf { margin: 16px 0; padding: 16px; background: var(--color-background-contrast); border-radius: var(--inputs-radius); border: 1px solid var(--color-border); }
  .pf__title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--f1);
    font-weight: var(--font-heading-weight);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 12px;
    opacity: 0.7;
  }
  .pf__form { display: flex; flex-direction: column; gap: 10px; }
  .pf__input-row { display: flex; gap: 8px; }
  .pf__input {
    flex: 1;
    height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--inputs-radius);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--f2);
    font-family: inherit;
    transition: border-color 0.15s;
  }
  .pf__input:focus { outline: none; border-color: var(--color-accent); }
  .pf__input.pf__input--error { border-color: var(--color-sale); }
  .pf__btn { height: 44px; white-space: nowrap; flex-shrink: 0; }
  .pf__result { font-size: var(--f1); }
  .pf__result-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .pf__result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    background: var(--color-background);
    border-radius: var(--inputs-radius);
    border: 1px solid var(--color-border);
    gap: 8px;
    flex-wrap: wrap;
  }
  .pf__result-name { font-weight: var(--font-heading-weight); font-size: var(--f1); }
  .pf__result-deadline { opacity: 0.7; font-size: var(--f1); flex: 1; text-align: center; }
  .pf__result-price { font-weight: var(--font-heading-weight); color: var(--color-accent); }
  .pf__result-price--free { color: var(--color-sale); }
  .pf__city { margin: 0 0 8px; font-size: var(--f0); opacity: 0.72; }
  .pf__error { color: var(--color-sale); padding: 8px 0; }
  .pf__loading { opacity: 0.6; padding: 8px 0; }
  .pf__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    font-size: var(--f0);
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pf__link:hover { opacity: 0.8; }
  @media screen and (max-width: 480px) {
    .pf__input-row { align-items: stretch; }
    .pf__input { min-width: 0; }
    .pf__btn { padding-inline: 16px; }
    .pf__result-item { align-items: flex-start; }
    .pf__result-deadline { order: 3; flex-basis: 100%; text-align: left; }
  }
</style>

<script>
  (function () {
    var calculator = document.getElementById('FreightForm-{{ section_id }}');
    if (!calculator) return;

    var input = calculator.querySelector('.pf__input');
    var button = calculator.querySelector('.pf__btn');
    var result = document.getElementById('FreightResult-{{ section_id }}');
    var section = document.querySelector('[data-section-id="{{ section_id }}"]');
    var rootUrl = {{ routes.root_url | json }};
    var requestId = 0;
    var strings = {
      invalidCep: {{ 'sections.product.freight.invalid_cep' | t | json }},
      calculating: {{ 'sections.product.freight.calculating' | t | json }},
      cepNotFound: {{ 'sections.product.freight.cep_not_found' | t | json }},
      error: {{ 'sections.product.freight.error' | t | json }},
      unavailable: {{ 'sections.product.freight.unavailable' | t | json }},
      noRates: {{ 'sections.product.freight.no_rates' | t | json }},
      deliveryTo: {{ 'sections.product.freight.delivery_to' | t | json }},
      businessDay: {{ 'sections.product.freight.business_day' | t | json }},
      businessDays: {{ 'sections.product.freight.business_days' | t | json }},
      estimatedDate: {{ 'sections.product.freight.estimated_date' | t | json }},
      deadlineAtCheckout: {{ 'sections.product.freight.deadline_at_checkout' | t | json }},
      free: {{ 'sections.product.freight.free' | t | json }}
    };

    if (rootUrl.charAt(rootUrl.length - 1) !== '/') rootUrl += '/';

    function escapeHtml(value) {
      var element = document.createElement('div');
      element.textContent = String(value || '');
      return element.innerHTML;
    }

    function showError(message) {
      result.innerHTML = '<p class="pf__error" role="alert">' + escapeHtml(message) + '</p>';
    }

    function setLoading(loading) {
      button.disabled = loading;
      input.disabled = loading;
      button.setAttribute('aria-busy', String(loading));
    }

    function selectedVariant() {
      var variantInput = section && section.querySelector('.product-variant-id');
      if (!variantInput || variantInput.disabled || !variantInput.value) return null;

      var quantityInput = section.querySelector('.quantity__input');
      var quantity = quantityInput ? parseInt(quantityInput.value, 10) : 1;
      return {
        id: Number(variantInput.value),
        quantity: Number.isFinite(quantity) ? Math.max(1, quantity) : 1
      };
    }

    function requestJson(url, options) {
      return fetch(url, options).then(function (response) {
        if (!response.ok) throw new Error('Request failed: ' + response.status);
        if (response.status === 202 || response.status === 204) return null;
        return response.text().then(function (text) { return text ? JSON.parse(text) : null; });
      });
    }

    function addTemporaryItem(variant) {
      return requestJson(rootUrl + 'cart/add.js', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: variant.id,
            quantity: variant.quantity,
            properties: { '_freight_quote': String(Date.now()) }
          }]
        })
      }).then(function (data) {
        var item = data && data.items && data.items[0];
        if (!item || !item.key) throw new Error('Temporary cart item was not created');
        return item.key;
      });
    }

    function removeTemporaryItem(itemKey, attempt) {
      return requestJson(rootUrl + 'cart/change.js', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: itemKey, quantity: 0 })
      }).catch(function (error) {
        if (attempt < 2) {
          return new Promise(function (resolve) { window.setTimeout(resolve, 300); })
            .then(function () { return removeTemporaryItem(itemKey, attempt + 1); });
        }
        throw error;
      });
    }

    function shippingParams(cep, address) {
      var params = new URLSearchParams();
      params.set('shipping_address[zip]', cep);
      params.set('shipping_address[country]', 'Brazil');
      if (address.uf) params.set('shipping_address[province]', address.uf);
      if (address.localidade) params.set('shipping_address[city]', address.localidade);
      return params.toString();
    }

    function pollRates(url, attempt) {
      return requestJson(url, { headers: { 'Accept': 'application/json' } }).then(function (data) {
        if (data && Array.isArray(data.shipping_rates)) return data.shipping_rates;
        if (attempt >= 14) throw new Error('Shipping rates timed out');
        return new Promise(function (resolve) { window.setTimeout(resolve, 700); })
          .then(function () { return pollRates(url, attempt + 1); });
      });
    }

    function quoteShipping(cep, address, variant) {
      var temporaryItemKey;
      var params = shippingParams(cep, address);
      var prepareUrl = rootUrl + 'cart/prepare_shipping_rates.json?' + params;
      var ratesUrl = rootUrl + 'cart/async_shipping_rates.json?' + params;

      return addTemporaryItem(variant)
        .then(function (itemKey) {
          temporaryItemKey = itemKey;
          return requestJson(prepareUrl, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: ''
          });
        })
        .then(function () { return pollRates(ratesUrl, 0); })
        .then(function (rates) {
          return removeTemporaryItem(temporaryItemKey, 0).then(function () { return rates; });
        }, function (error) {
          if (!temporaryItemKey) throw error;
          return removeTemporaryItem(temporaryItemKey, 0).then(function () { throw error; });
        });
    }

    function formatPrice(rate) {
      var amount = Number(rate.price);
      if (amount === 0) return strings.free;
      return new Intl.NumberFormat(document.documentElement.lang || 'pt-BR', {
        style: 'currency',
        currency: rate.currency || 'BRL'
      }).format(amount);
    }

    function formatDeadline(rate) {
      if (Array.isArray(rate.delivery_days) && rate.delivery_days.length) {
        var first = Number(rate.delivery_days[0]);
        var last = Number(rate.delivery_days[rate.delivery_days.length - 1]);
        if (first === last) return first + ' ' + (first === 1 ? strings.businessDay : strings.businessDays);
        return first + '–' + last + ' ' + strings.businessDays;
      }

      if (rate.delivery_date) {
        var date = new Date(rate.delivery_date + 'T12:00:00');
        var formattedDate = new Intl.DateTimeFormat(document.documentElement.lang || 'pt-BR').format(date);
        return strings.estimatedDate.replace('[date]', formattedDate);
      }

      return rate.description || strings.deadlineAtCheckout;
    }

    function showRates(rates, address) {
      if (!rates.length) {
        showError(strings.noRates);
        return;
      }

      rates.sort(function (a, b) { return Number(a.price) - Number(b.price); });
      var destination = [address.localidade, address.uf].filter(Boolean).join(' - ');
      var regionNote = destination
        ? '<p class="pf__city">' + escapeHtml(strings.deliveryTo) + ' ' + escapeHtml(destination) + '</p>'
        : '';
      var items = rates.map(function (rate) {
        var isFree = Number(rate.price) === 0;
        return '<li class="pf__result-item">' +
          '<span class="pf__result-name">' + escapeHtml(rate.presentment_name || rate.name) + '</span>' +
          '<span class="pf__result-deadline">' + escapeHtml(formatDeadline(rate)) + '</span>' +
          '<span class="pf__result-price' + (isFree ? ' pf__result-price--free' : '') + '">' + escapeHtml(formatPrice(rate)) + '</span>' +
          '</li>';
      }).join('');

      result.innerHTML = regionNote + '<ul class="pf__result-list" role="list">' + items + '</ul>';
    }

    // CEP mask: 00000-000
    input.addEventListener('input', function () {
      var v = input.value.replace(/\D/g, '').slice(0, 8);
      input.value = v.length > 5 ? v.slice(0, 5) + '-' + v.slice(5) : v;
      input.classList.remove('pf__input--error');
      result.innerHTML = '';
    });

    function calculateShipping() {
      var cep = input.value.replace(/\D/g, '');
      var variant = selectedVariant();
      var currentRequest = ++requestId;

      if (cep.length !== 8) {
        input.classList.add('pf__input--error');
        showError(strings.invalidCep);
        input.focus();
        return;
      }

      if (!variant) {
        showError(strings.unavailable);
        return;
      }

      setLoading(true);
      result.innerHTML = '<p class="pf__loading">' + escapeHtml(strings.calculating) + '</p>';

      fetch('https://viacep.com.br/ws/' + cep + '/json/')
        .then(function (response) {
          if (!response.ok) throw new Error('CEP lookup failed');
          return response.json();
        })
        .then(function (address) {
          if (address.erro) {
            input.classList.add('pf__input--error');
            throw new Error('CEP_NOT_FOUND');
          }
          return quoteShipping(cep, address, variant).then(function (rates) {
            if (currentRequest === requestId) showRates(rates, address);
          });
        })
        .catch(function (error) {
          if (currentRequest !== requestId) return;
          showError(error.message === 'CEP_NOT_FOUND' ? strings.cepNotFound : strings.error);
        })
        .finally(function () {
          if (currentRequest === requestId) setLoading(false);
        });
    }

    button.addEventListener('click', calculateShipping);
    input.addEventListener('keydown', function (event) {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      calculateShipping();
    });

    if (section) {
      section.querySelectorAll('.product__option input[type="radio"]').forEach(function (option) {
        option.addEventListener('change', function () { result.innerHTML = ''; });
      });
    }
  })();
</script>
