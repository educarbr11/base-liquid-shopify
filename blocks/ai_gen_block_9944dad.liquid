{% doc %}
  @prompt
    banner seja um caroussel de imagens banner, com um efeito de transição entre os banners, a transição dos banner deve ser no estilo paralax, onde a imagem aparece cortando uma e ainda aparecendo;
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-carousel-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    box-sizing: border-box;
    margin: 0 auto;
    {% comment %} padding: 24px; {% endcomment %}
  }

  .ai-banner-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    /* Permite scroll vertical da página; o arraste horizontal fica com o carrossel */
    touch-action: pan-y;
  }

  .ai-banner-carousel__wrapper-{{ ai_gen_id }}.is-draggable {
    cursor: grab;
  }

  .ai-banner-carousel__wrapper-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .ai-banner-carousel__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-banner-carousel__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: translateX(100%);
    transition: transform {{ block.settings.transition_duration }}s ease-in-out, opacity {{ block.settings.transition_duration }}s ease-in-out;
  }

  .ai-banner-carousel__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: translateX(0);
    z-index: 2;
  }

  .ai-banner-carousel__slide-{{ ai_gen_id }}.previous {
    opacity: 1;
    transform: translateX(-100%);
    z-index: 1;
  }

  .ai-banner-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  .ai-banner-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
  }

  .ai-banner-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-banner-carousel__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-banner-carousel__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-banner-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-banner-carousel__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-banner-carousel__arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-banner-carousel__arrow--prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-banner-carousel__arrow--next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-banner-carousel__arrow-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.arrow_size }}px * 0.5);
    height: calc({{ block.settings.arrow_size }}px * 0.5);
  }

  @media screen and (max-width: 1000px) {
    .ai-banner-carousel-{{ ai_gen_id }} {
      padding: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-banner-carousel__wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-banner-carousel__arrow-{{ ai_gen_id }} {
      width: calc({{ block.settings.arrow_size }}px * 0.8);
      height: calc({{ block.settings.arrow_size }}px * 0.8);
    }

    .ai-banner-carousel__arrow--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-banner-carousel__arrow--next-{{ ai_gen_id }} {
      right: 10px;
    }
  }
{% endstyle %}

<banner-carousel-{{ ai_gen_id }}
  class="ai-banner-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-banner-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-banner-carousel__slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'banner_image_' | append: i
          assign banner_image = block.settings[image_key]
        %}

        {% if banner_image != blank %}
          <div class="ai-banner-carousel__slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
            <img
              src="{{ banner_image | image_url: width: 2000 }}"
              alt="{{ banner_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ banner_image.width }}"
              height="{{ banner_image.height }}"
              class="ai-banner-carousel__image-{{ ai_gen_id }}"
              draggable="false"
            >
          </div>
        {% endif %}
      {% endfor %}

      {% assign has_images = false %}
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'banner_image_' | append: i
          assign banner_image = block.settings[image_key]
        %}
        {% if banner_image != blank %}
          {% assign has_images = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% unless has_images %}
        <div class="ai-banner-carousel__slide-{{ ai_gen_id }} active" data-slide="0">
          <div class="ai-banner-carousel__placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-banner-carousel__empty-state-{{ ai_gen_id }}">
              Adicione imagens de banner nas configurações
            </div>
          </div>
        </div>
      {% endunless %}
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-banner-carousel__arrow-{{ ai_gen_id }} ai-banner-carousel__arrow--prev-{{ ai_gen_id }}"
        aria-label="Banner anterior"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-banner-carousel__arrow-{{ ai_gen_id }} ai-banner-carousel__arrow--next-{{ ai_gen_id }}"
        aria-label="Próximo banner"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-banner-carousel__controls-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'banner_image_' | append: i
            assign banner_image = block.settings[image_key]
          %}
          {% if banner_image != blank %}
            <button
              class="ai-banner-carousel__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-slide="{{ forloop.index0 }}"
              aria-label="Ir para banner {{ forloop.index }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</banner-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.previousSlide = null;
        this.autoplayInterval = null;
        this.drag = null;
        this.isAnimating = false;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-banner-carousel__slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-banner-carousel__dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-banner-carousel__arrow--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-banner-carousel__arrow--next-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;
        this.wrapper = this.querySelector('.ai-banner-carousel__wrapper-{{ ai_gen_id }}');
        this.transitionMs = {{ block.settings.transition_duration }} * 1000;

        this.setupEventListeners();

        if (this.autoplay && this.slides.length > 1) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToSlide(this.currentSlide - 1);
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToSlide(this.currentSlide + 1);
            this.resetAutoplay();
          });
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideIndex = parseInt(e.target.dataset.slide);
            this.goToSlide(slideIndex);
            this.resetAutoplay();
          });
        });

        this.setupDrag();
      }

      // ---- Arrastar para trocar de banner (touch + mouse) ----
      setupDrag() {
        if (!this.wrapper || this.slides.length < 2) return;

        this.wrapper.classList.add('is-draggable');

        this.wrapper.addEventListener('pointerdown', (e) => this.onDragStart(e));
        this.wrapper.addEventListener('pointermove', (e) => this.onDragMove(e));
        this.wrapper.addEventListener('pointerup', (e) => this.onDragEnd(e));
        this.wrapper.addEventListener('pointercancel', (e) => this.onDragEnd(e, true));
        this.wrapper.addEventListener('dragstart', (e) => e.preventDefault());

        // Evita clique acidental após arrastar
        this.wrapper.addEventListener('click', (e) => {
          if (this.suppressClick) {
            e.preventDefault();
            e.stopPropagation();
            this.suppressClick = false;
          }
        }, true);
      }

      wrapIndex(index) {
        const total = this.slides.length;
        return (index + total) % total;
      }

      onDragStart(e) {
        if (this.isAnimating) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        if (e.target.closest('button')) return;

        this.drag = {
          pointerId: e.pointerId,
          startX: e.clientX,
          startY: e.clientY,
          dx: 0,
          width: this.wrapper.offsetWidth,
          active: false,
          neighbor: null
        };
      }

      onDragMove(e) {
        const drag = this.drag;
        if (!drag || e.pointerId !== drag.pointerId) return;

        const dx = e.clientX - drag.startX;
        const dy = e.clientY - drag.startY;

        if (!drag.active) {
          // Só inicia o arraste se o movimento for predominantemente horizontal
          if (Math.abs(dx) < 6) return;
          if (Math.abs(dy) > Math.abs(dx)) {
            this.drag = null;
            return;
          }
          drag.active = true;
          this.wrapper.setPointerCapture(e.pointerId);
          this.wrapper.classList.add('is-dragging');
          clearInterval(this.autoplayInterval);
        }

        drag.dx = dx;

        const current = this.slides[this.currentSlide];
        const direction = dx < 0 ? 1 : -1; // 1 = próximo, -1 = anterior
        const neighborIndex = this.wrapIndex(this.currentSlide + direction);
        const neighbor = this.slides[neighborIndex];

        // Se trocou de direção, restaura o vizinho anterior
        if (drag.neighbor && drag.neighbor !== neighbor && drag.neighbor !== current) {
          this.clearInline(drag.neighbor);
        }
        drag.neighbor = neighbor;
        drag.neighborIndex = neighborIndex;
        drag.direction = direction;

        current.style.transition = 'none';
        current.style.transform = `translateX(${dx}px)`;

        if (neighbor !== current) {
          neighbor.style.transition = 'none';
          neighbor.style.opacity = '1';
          neighbor.style.zIndex = '2';
          neighbor.style.transform = `translateX(${direction * drag.width + dx}px)`;
        }
      }

      onDragEnd(e, cancelled = false) {
        const drag = this.drag;
        if (!drag || e.pointerId !== drag.pointerId) return;
        this.drag = null;

        if (!drag.active) return;

        this.wrapper.classList.remove('is-dragging');
        if (this.wrapper.hasPointerCapture(e.pointerId)) {
          this.wrapper.releasePointerCapture(e.pointerId);
        }
        this.suppressClick = true;
        setTimeout(() => { this.suppressClick = false; }, 50);

        const threshold = Math.min(80, drag.width * 0.15);
        const commit = !cancelled && Math.abs(drag.dx) > threshold;
        const current = this.slides[this.currentSlide];
        const neighbor = drag.neighbor;
        const transition = `transform ${this.transitionMs}ms ease-out`;

        this.isAnimating = true;
        current.style.transition = transition;
        if (neighbor && neighbor !== current) neighbor.style.transition = transition;

        if (commit) {
          current.style.transform = `translateX(${-drag.direction * 100}%)`;
          neighbor.style.transform = 'translateX(0)';
        } else {
          current.style.transform = 'translateX(0)';
          if (neighbor && neighbor !== current) {
            neighbor.style.transform = `translateX(${drag.direction * 100}%)`;
          }
        }

        setTimeout(() => {
          this.slides.forEach((slide) => {
            slide.style.transition = 'none';
            this.clearInline(slide, true);
          });

          if (commit) this.setActiveSlide(drag.neighborIndex);

          // Força reflow para aplicar as classes sem animar, depois libera as transições
          void this.wrapper.offsetWidth;
          this.slides.forEach((slide) => { slide.style.transition = ''; });

          this.isAnimating = false;
          this.resetAutoplay();
        }, this.transitionMs + 20);
      }

      clearInline(slide, keepTransition = false) {
        slide.style.transform = '';
        slide.style.opacity = '';
        slide.style.zIndex = '';
        if (!keepTransition) slide.style.transition = '';
      }

      // Define o slide ativo sem animação de classe (usado após o arraste)
      setActiveSlide(index) {
        this.slides.forEach((slide) => slide.classList.remove('active', 'previous'));
        this.dots.forEach((dot) => dot.classList.remove('active'));

        this.previousSlide = null;
        this.currentSlide = index;
        this.slides[index].classList.add('active');
        if (this.dots[index]) this.dots[index].classList.add('active');
      }

      goToSlide(index) {
        if (this.slides.length === 0 || this.isAnimating || this.drag) return;

        if (index < 0) {
          index = this.slides.length - 1;
        } else if (index >= this.slides.length) {
          index = 0;
        }

        if (this.previousSlide !== null) {
          this.slides[this.previousSlide].classList.remove('previous');
        }

        this.slides[this.currentSlide].classList.remove('active');
        this.slides[this.currentSlide].classList.add('previous');
        
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.previousSlide = this.currentSlide;
        this.currentSlide = index;

        this.slides[this.currentSlide].classList.remove('previous');
        this.slides[this.currentSlide].classList.add('active');
        
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.goToSlide(this.currentSlide + 1);
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        if (this.autoplay) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('banner-carousel-{{ ai_gen_id }}', BannerCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carrossel de banners",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Imagens dos banners"
    },
    {
      "type": "image_picker",
      "id": "banner_image_1",
      "label": "Banner 1"
    },
    {
      "type": "image_picker",
      "id": "banner_image_2",
      "label": "Banner 2"
    },
    {
      "type": "image_picker",
      "id": "banner_image_3",
      "label": "Banner 3"
    },
    {
      "type": "image_picker",
      "id": "banner_image_4",
      "label": "Banner 4"
    },
    {
      "type": "image_picker",
      "id": "banner_image_5",
      "label": "Banner 5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largura no desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Altura do banner (desktop)",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Altura do banner (mobile)",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Raio da borda",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Transição"
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Duração da transição",
      "min": 0.5,
      "max": 2,
      "step": 0.5,
      "unit": "s",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reprodução automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Velocidade da reprodução automática",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Navegação"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar setas",
      "default": true
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Tamanho das setas",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Fundo das setas",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Cor das setas",
      "default": "#0B1D3A"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar indicadores",
      "default": true
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Tamanho dos indicadores",
      "min": 8,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Cor dos indicadores",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Carrossel de banners"
    }
  ]
}
{% endschema %}
