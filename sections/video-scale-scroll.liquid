{%- comment -%}
  ============================================================
  VIDEO SCALE SCROLL
  ============================================================
  Seção de vídeo que começa pequena (alinhada às demais sections)
  e vai crescendo conforme o usuário scrolla, chegando até
  a largura total configurada. Suporta YouTube e vídeo nativo.
{%- endcomment -%}

{%- assign vid_id = '' -%}
{%- if section.settings.youtube_url != blank -%}
  {%- assign raw_url = section.settings.youtube_url -%}
  {%- if raw_url contains 'youtu.be/' -%}
    {%- assign vid_id = raw_url | split: 'youtu.be/' | last | split: '?' | first -%}
  {%- elsif raw_url contains 'v=' -%}
    {%- assign vid_id = raw_url | split: 'v=' | last | split: '&' | first -%}
  {%- endif -%}
{%- endif -%}

<section
  class="vss"
  data-section-id="{{ section.id }}"
  style="--vss-radius: {{ section.settings.border_radius }}px;"
>
  <div class="vss__track">
    <div class="vss__sticky">
      <div class="vss__frame-outer page-width">
        <div class="vss__frame" id="VssFrame-{{ section.id }}">

          {%- if vid_id != '' -%}
            <iframe
              id="VssIframe-{{ section.id }}"
              class="vss__player"
              src="https://www.youtube.com/embed/{{ vid_id }}?autoplay=1&mute=1&loop=1&playlist={{ vid_id }}&controls=0&playsinline=1&rel=0&modestbranding=1"
              title="{{ section.settings.title | default: 'Vídeo' | escape }}"
              frameborder="0"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          {%- elsif section.settings.video != blank -%}
            <video
              class="vss__player"
              autoplay muted loop playsinline
            >
              {%- for source in section.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- else -%}
            <div class="vss__placeholder">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- if section.settings.overlay_opacity > 0 -%}
            <div
              class="vss__overlay"
              style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
            ></div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vss {
    /* Espaço de scroll: altura desta seção determina la velocidade do efeito */
    position: relative;
    width: 100%;
    padding: 0;
  }
  .vss__track {
    /* Área de scroll que mantém a sticky funcionando */
    height: {{ section.settings.scroll_height }}vh;
    position: relative;
  }
  .vss__sticky {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    pointer-events: none; /* Permite scrollar sobre o vídeo */
    z-index: 1;
  }
  .vss__sticky .page-width {
    pointer-events: auto;
    width: 100%;
  }
  .vss__frame-outer {
    /* Contenedor que CRESCE via JS */
    width: 100%;
    transition: none; /* JS controla via scale/width */
  }
  .vss__frame {
    position: relative;
    width: 100%;
    border-radius: var(--vss-radius, 20px);
    overflow: hidden;
    background: #000;
    /* Aspect ratio do vídeo 16:9 */
    aspect-ratio: 16 / 9;
    /* Sombra para dar profundidade quando pequeno */
    box-shadow: 0 32px 80px rgba(0,0,0,0.35);
    transition: border-radius 0.1s linear, box-shadow 0.1s linear;
  }
  .vss__player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
    display: block;
  }
  .vss__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .vss__placeholder {
    width: 100%;
    height: 100%;
    background: #1a1a2e;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vss__placeholder svg {
    max-width: 200px;
    opacity: 0.4;
  }

  @media screen and (max-width: 749px) {
    .vss__track {
      height: 200vh; /* Mais espaço de scroll no mobile */
    }
    .vss__frame {
      border-radius: calc(var(--vss-radius, 20px) * 0.5);
    }
  }
</style>

<script>
(function() {
  const section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;

  const track   = section.querySelector('.vss__track');
  const frame   = section.querySelector('#VssFrame-{{ section.id }}');
  const sticky  = section.querySelector('.vss__sticky');

  // Escala inicial (ex: 0.55 = 55% da largura da page-width)
  const scaleStart = {{ section.settings.scale_start | divided_by: 100.0 }};
  const scaleEnd   = 1.0; // 100%

  function lerp(a, b, t) { return a + (b - a) * t; }

  function onScroll() {
    const trackRect  = track.getBoundingClientRect();
    const trackH     = track.offsetHeight;
    const viewH      = window.innerHeight;

    // progress: 0 quando o topo do track chega no topo da viewport
    //            1 quando o fundo do track chega no fundo da viewport
    const scrolled   = -trackRect.top;             // px scrollados dentro da track
    const available  = trackH - viewH;             // px totais disponíveis
    const progress   = Math.min(1, Math.max(0, scrolled / Math.max(1, available)));

    const scale = lerp(scaleStart, scaleEnd, progress);

    // Arredondamento: some gradualmente com o prog
    const radiusMax = {{ section.settings.border_radius }};
    const radius    = radiusMax * (1 - progress);
    const shadow    = `0 ${lerp(32, 0, progress)}px ${lerp(80, 0, progress)}px rgba(0,0,0,${lerp(0.35, 0, progress).toFixed(2)})`;

    frame.style.transform    = `scale(${scale})`;
    frame.style.transformOrigin = 'center center';
    frame.style.borderRadius = `${radius}px`;
    frame.style.boxShadow    = shadow;
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // estado inicial
})();
</script>

{% schema %}
{
  "name": "Vídeo Scale Scroll",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Vídeo"
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "URL do YouTube",
      "info": "Cole o link do vídeo (youtu.be/... ou youtube.com/watch?v=...)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Ou vídeo nativo",
      "info": "Usado apenas se a URL do YouTube estiver vazia."
    },
    {
      "type": "header",
      "content": "Efeito de Escala"
    },
    {
      "type": "range",
      "id": "scale_start",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Tamanho inicial (% da largura)",
      "default": 55,
      "info": "O vídeo começa neste tamanho e cresce até 100% conforme o scroll."
    },
    {
      "type": "range",
      "id": "scroll_height",
      "min": 150,
      "max": 400,
      "step": 25,
      "unit": "vh",
      "label": "Altura da área de scroll",
      "default": 250,
      "info": "Quanto maior, mais lento o crescimento do vídeo ao scrollar."
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Arredondamento inicial das bordas",
      "default": 20,
      "info": "Diminui até 0 conforme o vídeo expande."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Cor do overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Opacidade do overlay",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Vídeo Scale Scroll",
      "settings": {
        "youtube_url": "https://youtu.be/sQxA7gHfsXk?si=4mrpvcF64A3fnmep",
        "scale_start": 55,
        "scroll_height": 250,
        "border_radius": 20
      }
    }
  ]
}
{% endschema %}
