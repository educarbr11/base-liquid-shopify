{%- comment -%}
  ============================================================
  COLLECTION BANNER — hero da página de coleção
  ============================================================
  Banner full-width com imagem ou vídeo de fundo, texto à esquerda,
  e divider SVG curvo na base.
{%- endcomment -%}

<div class='collection-hero' data-section-id='{{ section.id }}'>
  {%- comment -%} Mídia de fundo — vídeo, imagem configurada ou imagem da coleção {%- endcomment -%}
  <div
    class='collection-hero__bg'
    style='--collection-video-position-x: {{ section.settings.video_position_x }}%; --collection-video-position-y: {{ section.settings.video_position_y }}%;'
  >
    {%- if section.settings.background_video != blank -%}
      {{
        section.settings.background_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          image_size: '1920x',
          class: 'collection-hero__bg-video'
      }}
    {%- elsif section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 1920 | image_tag: loading: 'eager', sizes: '100vw', widths: '540, 720, 1080, 1440, 1920', class: 'collection-hero__bg-img', alt: collection.title | escape }}
    {%- elsif collection.image -%}
      {{ collection.image | image_url: width: 1920 | image_tag: loading: 'eager', sizes: '100vw', widths: '540, 720, 1080, 1440, 1920', class: 'collection-hero__bg-img', alt: collection.title | escape }}
    {%- endif -%}
  </div>

  <div class='collection-hero__content page-width'>
    <span class='collection-hero__label'>COLEÇÃO</span>
    <h1 class='collection-hero__title'>{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class='collection-hero__description rte'>{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Divider SVG curvo {%- endcomment -%}
  <div class='collection-hero__divider'>
    <svg width='1179' height='25' viewBox='0 0 1179 25' fill='none' xmlns='http://www.w3.org/2000/svg'>
      <path d="M1179 45.2028V21.8655C1179 11.7692 1172.09 2.9857 1162.27 0.612593C1160.59 0.205638 1158.87 0 1157.13 0L1014.65 0C1010.9 0 1007.19 0.812675 1003.78 2.38217L966.209 19.6759C962.799 21.2454 959.09 22.058 955.337 22.058L656.496 22.058C653.145 22.058 649.826 21.4103 646.721 20.1504L601.759 1.90761C598.654 0.647752 595.335 0 591.984 0L21.6969 0C20.6315 0 19.5675 0.0784727 18.5137 0.234782C7.87659 1.81245 0 10.9435 0 21.6968V48.8717C0 59.3659 7.09229 68.534 17.2499 71.1705C19.14 71.6611 21.0848 71.9094 23.0377 71.9094L585.721 71.9094L657.519 81L964.575 81C966.443 81 968.305 80.7987 970.13 80.3997L1006.21 72.5097C1008.03 72.1106 1009.89 71.9094 1011.76 71.9094H1148.5C1149.85 71.9094 1151.2 71.8041 1152.53 71.5946L1157.03 70.888C1169.68 68.9018 1179 58.0049 1179 45.2028Z" fill="white"/>
    </svg>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .collection-hero {
    position: relative;
    width: 100%;
    min-height: 280px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #0B1D3A;
  }

  /* Background media */
  #shopify-section-{{ section.id }} .collection-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .collection-hero__bg-img,
  #shopify-section-{{ section.id }} .collection-hero__bg-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  #shopify-section-{{ section.id }} .collection-hero__bg-video {
    object-position: var(--collection-video-position-x, 50%) var(--collection-video-position-y, 50%);
    pointer-events: none;
  }

  /* Content */
  #shopify-section-{{ section.id }} .collection-hero__content {
    position: relative;
    z-index: 1;
    padding-top: 48px;
    padding-bottom: 72px;
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .collection-hero__label {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #E8A817;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .collection-hero__title {
    font-family: 'Bungee', sans-serif;
    font-size: clamp(1.2rem, 4vw, 2.8rem);
    font-weight: 900;
    text-transform: uppercase;
    max-width: 12ch;
    line-height: 1.1;
    margin: 0;
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .collection-hero__description {
    margin-top: 12px;
    font-size: var(--f2, 0.95rem);
    color: rgba(255, 255, 255, 0.85);
    max-width: 520px;
  }

  /* Entrada suave dos textos do banner */
  #shopify-section-{{ section.id }} .collection-hero__label,
  #shopify-section-{{ section.id }} .collection-hero__title,
  #shopify-section-{{ section.id }} .collection-hero__description {
    animation: collectionTextReveal 0.65s ease-out both;
  }
  #shopify-section-{{ section.id }} .collection-hero__title {
    animation-delay: 0.1s;
  }
  #shopify-section-{{ section.id }} .collection-hero__description {
    animation-delay: 0.2s;
  }
  @keyframes collectionTextReveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Divider SVG */
  #shopify-section-{{ section.id }} .collection-hero__divider {
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100%;
    z-index: 2;
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .collection-hero__divider svg {
    display: block;
    width: 100%;
    height: 40px;
  }

  /* ─── Responsive ─── */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .collection-hero {
      min-height: 180px;
    }
    #shopify-section-{{ section.id }} .collection-hero__bg-img {
      object-fit: cover;
      object-position: right;
    }
    #shopify-section-{{ section.id }} .collection-hero__bg-video { object-fit: cover; }
    #shopify-section-{{ section.id }} .collection-hero__content {
      padding-top: 32px;
      padding-bottom: 56px;
    }
    #shopify-section-{{ section.id }} .collection-hero__label {
      font-size: 0.85rem;
    }
    #shopify-section-{{ section.id }} .collection-hero__divider svg {
      height: 28px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .collection-hero {
      min-height: 80px;
    }
    #shopify-section-{{ section.id }} .collection-hero__content {
      padding-top: 24px;
      padding-bottom: 48px;
    }
    #shopify-section-{{ section.id }} .collection-hero__label {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .collection-hero__label,
    #shopify-section-{{ section.id }} .collection-hero__title,
    #shopify-section-{{ section.id }} .collection-hero__description {
      animation: none;
    }
  }
</style>

<script>
  ;(function () {
    var section = document.getElementById('shopify-section-{{ section.id }}')
    var video = section && section.querySelector('.collection-hero__bg-video')
    if (!video) return

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    function updatePlayback() {
      if (reducedMotion.matches) {
        video.pause()
      } else {
        var playPromise = video.play()
        if (playPromise) playPromise.catch(function () {})
      }
    }

    updatePlayback()
    if (reducedMotion.addEventListener) reducedMotion.addEventListener('change', updatePlayback)
  })()
</script>

{% schema %}
{
  "name": "Banner da Coleção",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "video",
      "id": "background_video",
      "label": "Vídeo de fundo",
      "info": "Quando selecionado, o vídeo tem prioridade sobre a imagem. Reproduz automaticamente, sem som e em loop."
    },
    {
      "type": "range",
      "id": "video_position_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "label": "Posição horizontal do vídeo"
    },
    {
      "type": "range",
      "id": "video_position_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "label": "Posição vertical do vídeo",
      "info": "0% prioriza o topo e 100% prioriza a parte inferior."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de fundo",
      "info": "Usada quando não há vídeo. Se ambos estiverem vazios, usa a imagem da coleção."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": false,
      "label": "Mostrar descrição da coleção"
    }
  ]
}
{% endschema %}
