{%- comment -%}
  ============================================================
  MAIN PRODUCT — página de produto (Shopify OS 2.0)
  ============================================================

  O QUE FAZ:
  Renderiza a página completa de um produto: galeria de mídias
  (via snippet product-gallery), breadcrumb, avaliação, vendor,
  title, SKU, estoque, preço + PIX + parcelamento, seletor de
  variantes (cards), quantidade, botões de compra, frete, benefícios,
  informações rápidas, tabs, trust, ecossistema e relacionados.

  ONDE É USADA:
  templates/product.json como section principal.

  BLOCOS CONFIGURÁVEIS (Theme Editor):
  @app, vendor, title, rating, sku, stock, price, variant_picker,
  quantity, buy_buttons, freight, benefits, quick_info, tabs, trust,
  ecosystem, related, share, custom_liquid

  SNIPPETS RENDERIZADOS:
  product-gallery, product-description-collapse, product-freight, product-benefits,
  product-quick-info, product-tabs, product-trust, product-ecosystem, product-related,
  price, share-button, structured-data-product
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign section_id = section.id
-%}

{%- comment -%} JSON-LD Product Schema {%- endcomment -%}
{%- render 'structured-data-product', product: product -%}

{%- comment -%} Breadcrumb {%- endcomment -%}
{%- if section.settings.show_breadcrumb -%}
  <nav class='prod-breadcrumb page-width' aria-label='{{ 'sections.product.breadcrumb' | t | default: 'Você está em' }}'>
    <ol class='prod-breadcrumb__list' itemscope itemtype='https://schema.org/BreadcrumbList'>
      <li class='prod-breadcrumb__item' itemprop='itemListElement' itemscope itemtype='https://schema.org/ListItem'>
        <a href='{{ routes.root_url }}' class='prod-breadcrumb__link' itemprop='item'>
          <span itemprop='name'>{{ 'general.breadcrumbs.home' | t | default: 'Início' }}</span>
        </a>
        <meta itemprop='position' content='1'>
      </li>
      {%- if product.collections.size > 0 -%}
        {%- assign bc_coll = product.collections | first -%}
        <li class='prod-breadcrumb__sep' aria-hidden='true'>
          <svg width='12' height='12' viewBox='0 0 16 16' fill='none'>
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="rotate(-90 8 8)"/>
          </svg>
        </li>
        <li class='prod-breadcrumb__item' itemprop='itemListElement' itemscope itemtype='https://schema.org/ListItem'>
          <a href='{{ bc_coll.url }}' class='prod-breadcrumb__link' itemprop='item'>
            <span itemprop='name'>{{ bc_coll.title | escape }}</span>
          </a>
          <meta itemprop='position' content='2'>
        </li>
      {%- endif -%}
      <li class='prod-breadcrumb__sep' aria-hidden='true'>
        <svg width='12' height='12' viewBox='0 0 16 16' fill='none'>
          <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="rotate(-90 8 8)"/>
        </svg>
      </li>
      <li class='prod-breadcrumb__item' itemprop='itemListElement' itemscope itemtype='https://schema.org/ListItem'>
        <span class='prod-breadcrumb__current' itemprop='name' aria-current='page'>{{ product.title | escape }}</span>
        <meta itemprop='position' content='3'>
      </li>
    </ol>
  </nav>
{%- endif -%}

<section class='product page-width' data-section-id='{{ section.id }}'>
  {{- '<!-- LEFT: Gallery -->' -}}
  <div class='product__media-wrapper'>
    {% render 'product-gallery', product: product, section_id: section_id %}
    <div class='product__desc-under-media'>
      {% render 'product-description-collapse',
        product: product,
        section_id: section_id,
        show: section.settings.show_description_under_media,
        more_label: section.settings.description_more_label,
        less_label: section.settings.description_less_label
      %}
    </div>
  </div>

  {{- '<!-- RIGHT: Info + Form -->' -}}
  <div class='product__info'>
    {%- form 'product', product, id: product_form_id, class: 'product__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type='hidden'
        name='id'
        value='{{ current_variant.id }}'
        {% if current_variant.available == false %}
          disabled
        {% endif %}
        class='product-variant-id'>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class='product__vendor' {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class='product__title' {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'rating' -%}
            <div class='product__rating' {{ block.shopify_attributes }} aria-label='{{ 'sections.product.rating.label' | t | default: 'Avaliação do produto' }}'>
              {%- assign rating_val = product.metafields.reviews.rating.value -%}
              {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
              {%- if rating_val != blank -%}
                <div class='prod-stars' aria-hidden='true'>
                  {%- assign full = rating_val | floor -%}
                  {%- assign half = 0 -%}
                  {%- assign rate_diff = rating_val | minus: full -%}
                  {%- if rate_diff >= 0.4 -%}{%- assign half = 1 -%}{%- endif -%}
                  {%- assign empty = 5 | minus: full | minus: half -%}
                  {%- for s in (1..full) -%}
                    <span class='prod-star prod-star--full'>★</span>
                  {%- endfor -%}
                  {%- if half == 1 -%}
                    <span class='prod-star prod-star--half'>★</span>
                  {%- endif -%}
                  {%- for s in (1..empty) -%}
                    <span class='prod-star prod-star--empty'>☆</span>
                  {%- endfor -%}
                </div>
                <span class='prod-rating-value'>{{ rating_val }}</span>
                {%- if rating_count != blank -%}
                  <span class='prod-rating-count'>
                    ({{ rating_count }}
                    {{ block.settings.reviews_label | default: 'avaliações' | escape }})
                  </span>
                {%- endif -%}
              {%- else -%}
                {%- if block.settings.placeholder_text != blank -%}
                  <span class='prod-rating-placeholder'>{{ block.settings.placeholder_text | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'sku' -%}
            {%- if current_variant.sku != blank -%}
              <p class='product__sku' {{ block.shopify_attributes }}>
                <span class='product__sku-label'>{{ block.settings.label | default: 'SKU:' | escape }}</span>
                <span class='product__sku-value' id='ProductSKU-{{ section.id }}'>{{ current_variant.sku }}</span>
              </p>
            {%- endif -%}

          {%- when 'stock' -%}
            <div class='product__stock' id='ProductStock-{{ section.id }}' {{ block.shopify_attributes }}>
              {%- if current_variant.available -%}
                {%- assign qty = current_variant.inventory_quantity -%}
                {%- if current_variant.inventory_management != blank and qty <= block.settings.low_stock_threshold and qty > 0 -%}
                  <span class='prod-stock prod-stock--low'>
                    <span class='prod-stock__dot' aria-hidden='true'></span>
                    {{ block.settings.low_stock_text | default: 'Últimas unidades' | escape }} ({{ qty }})
                  </span>
                {%- elsif current_variant.inventory_management != blank and qty <= 0 -%}
                  <span class='prod-stock prod-stock--out'>
                    <span class='prod-stock__dot' aria-hidden='true'></span>
                    {{ 'products.product.sold_out' | t }}
                  </span>
                {%- else -%}
                  <span class='prod-stock prod-stock--in'>
                    <span class='prod-stock__dot' aria-hidden='true'></span>
                    {{ block.settings.in_stock_text | default: 'Em estoque' | escape }}
                  </span>
                {%- endif -%}
              {%- else -%}
                <span class='prod-stock prod-stock--out'>
                  <span class='prod-stock__dot' aria-hidden='true'></span>
                  {{ 'products.product.sold_out' | t }}
                </span>
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class='product__price' {{ block.shopify_attributes }} id='ProductPrice-{{ section.id }}'>
              {% render 'price', product: product, use_variant: true, show_compare: true %}

              {%- if block.settings.show_pix and block.settings.pix_text != blank -%}
                <p class='product__pix'>
                  <span class='product__pix-badge' aria-label='{{ 'sections.product.pix_label' | t | default: 'PIX' }}'>PIX</span>
                  {{ block.settings.pix_text | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.show_installments and block.settings.installments_text != blank -%}
                <p class='product__installments'>{{ block.settings.installments_text | escape }}</p>
              {%- endif -%}

              {%- if current_variant.unit_price_measurement -%}
                <div class='product__unit-price'>
                  {{ current_variant.unit_price | money }}
                  <span aria-hidden='true'>/</span>
                  {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                    {{ current_variant.unit_price_measurement.reference_value }}
                  {%- endif -%}
                  {{ current_variant.unit_price_measurement.reference_unit }}
                </div>
              {%- endif -%}

              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <div class='product__tax caption'>
                  {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class='product__variants' {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class='product__option'>
                    <legend class='product__option-name'>{{ option.name }}</legend>
                    <div class='product__option-cards'>
                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_disabled = true
                          for variant in product.variants
                            if variant.available and variant.options[forloop.parentloop.index0] == value
                              assign option_disabled = false
                              break
                            endif
                          endfor
                        -%}
                        <label class='product__swatch {% if option.selected_value == value %}is-selected{% endif %} {% if option_disabled %}is-unavailable{% endif %}'>
                          <input
                            type='radio'
                            name='{{ option.name }}'
                            value='{{ value | escape }}'
                            class='visually-hidden'
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                            data-option-index='{{ forloop.parentloop.index0 }}'
                            aria-label='{{ option.name }}: {{ value | escape }}'>
                          {%- if value.swatch.image -%}
                            <span class='product__swatch-media' style='background-image:url({{ value.swatch.image | image_url: width: 100 }})'></span>
                          {%- elsif value.swatch.color -%}
                            <span class='product__swatch-color' style='background-color:{{ value.swatch.color }}'></span>
                          {%- else -%}
                            <span class='product__swatch-label'>{{ value }}</span>
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>

              <script type='application/json' data-variant-json>
                [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id | json }},
                      "options": {{ variant.options | json }},
                      "available": {{ variant.available | json }},
                      "sku": {{ variant.sku | json }},
                      "inventory_quantity": {{ variant.inventory_quantity | json }},
                      "inventory_management": {{ variant.inventory_management | json }},
                      "featured_media_id": {{ variant.featured_media.id | json }},
                      "price_html": {%- capture vph -%}{% render 'price', product: variant, use_variant: false, show_compare: true %}{%- endcapture -%}{{ vph | strip_newlines | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>
            {%- endunless -%}

          {%- when 'quantity' -%}
            {%- comment -%} Quantidade é renderizada junto aos botões de compra {%- endcomment -%}
            {%- assign product_has_buy_buttons = false -%}
            {%- for b in section.blocks -%}
              {%- if b.type == 'buy_buttons' -%}
                {%- assign product_has_buy_buttons = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless product_has_buy_buttons -%}
              <div class='product__quantity' {{ block.shopify_attributes }}>
                <label class='field__label' for='Quantity-{{ section.id }}'>
                  {{ 'products.product.quantity.label' | t }}
                </label>
                <div class='quantity-selector'>
                  <button type='button' class='quantity__button' name='minus' aria-label='{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}'>−</button>
                  <input
                    class='quantity__input'
                    type='number'
                    name='quantity'
                    id='Quantity-{{ section.id }}'
                    min='1'
                    value='1'
                    aria-label='{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}'>
                  <button type='button' class='quantity__button' name='plus' aria-label='{{ 'products.product.quantity.increase' | t: product: product.title | escape }}'>+</button>
                </div>
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class='product__purchase product__buy-buttons' {{ block.shopify_attributes }}>
              {{- '<!-- Row: quantidade + adicionar ao carrinho -->' -}}
              <div class='product__purchase-row product__purchase-row--cart'>
                <div class='product__quantity product__quantity--inline'>
                  <label class='visually-hidden' for='Quantity-{{ section.id }}'>
                    {{ 'products.product.quantity.label' | t }}
                  </label>
                  <div class='quantity-selector'>
                    <button type='button' class='quantity__button' name='minus' aria-label='{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}'>−</button>
                    <input
                      class='quantity__input'
                      type='number'
                      name='quantity'
                      id='Quantity-{{ section.id }}'
                      min='1'
                      value='1'
                      aria-label='{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}'>
                    <button type='button' class='quantity__button' name='plus' aria-label='{{ 'products.product.quantity.increase' | t: product: product.title | escape }}'>+</button>
                  </div>
                </div>

                <button
                  type='submit'
                  name='add'
                  class='button product__add-to-cart'
                  {% if current_variant.available == false %}
                    disabled
                  {% endif %}
                  aria-label='{{ 'products.product.add_to_cart' | t }}'>
                  <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                    <path d="M6 6h15l-1.5 9h-12L6 6Zm0 0-.5-3H3"/><circle cx="9" cy="20" r="1.5" fill="currentColor"/><circle cx="17" cy="20" r="1.5" fill="currentColor"/>
                  </svg>
                  <span>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
              </div>

              {{- '<!-- Row: comprar agora + favorito -->' -}}
              {%- if block.settings.show_buy_now or block.settings.show_wishlist -%}
                <div class='product__purchase-row product__purchase-row--buy'>
                  {%- if block.settings.show_buy_now -%}
                    {%- if block.settings.show_dynamic_checkout -%}
                      <div class='product__buy-now-wrap'>
                        {{ form | payment_button }}
                      </div>
                    {%- else -%}
                      <button
                        type='submit'
                        name='add'
                        class='button product__buy-now'
                        id='BuyNowBtn-{{ section.id }}'
                        formaction='{{ routes.cart_add_url }}'
                        data-buy-now
                        {% if current_variant.available == false %}
                          disabled
                        {% endif %}
                        aria-label='{{ block.settings.buy_now_label | default: 'Comprar Agora' | escape }}'>
                        {{ block.settings.buy_now_label | default: 'Comprar Agora' | escape }}
                      </button>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block.settings.show_wishlist -%}
                    <button
                      type='button'
                      class='product__wishlist'
                      aria-label='{{ block.settings.wishlist_label | default: 'Favoritar produto' | escape }}'
                      data-product-id='{{ product.id }}'>
                      <svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      </svg>
                      <span class='visually-hidden'>{{ block.settings.wishlist_label | default: 'Favoritar produto' | escape }}</span>
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            <div class='product__desc-under-info'>
              {% render 'product-description-collapse',
                product: product,
                section_id: block.id,
                show: section.settings.show_description_under_media,
                more_label: section.settings.description_more_label,
                less_label: section.settings.description_less_label
              %}
            </div>

          {%- when 'share' -%}
            <div class='product__share' {{ block.shopify_attributes }}>
              {% render 'share-button', share_link: product.url, share_title: product.title %}
            </div>

          {%- when 'freight' -%}
            {% render 'product-freight', block: block, section_id: section_id %}

          {%- when 'benefits' -%}
            {% render 'product-benefits', block: block %}

          {%- when 'quick_info' -%}
            {% render 'product-quick-info', product: product, block: block %}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class='product__description rte' {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    {%- endform -%}
  </div>
</section>

{{- '<!-- Mobile sticky CTA -->' -}}
<div class='product__mobile-cta' id='ProductMobileCTA-{{ section.id }}' aria-hidden='true' hidden>
  <div class='product__mobile-cta-inner page-width'>
    <div class='product__mobile-cta-info'>
      <span class='product__mobile-cta-title'>{{ product.title | truncate: 40 | escape }}</span>
      <span class='product__mobile-cta-price' id='MobileCTAPrice-{{ section.id }}'>
        {% render 'price', product: product, use_variant: true, show_compare: false %}
      </span>
    </div>
    <button
      type='submit'
      form='{{ product_form_id }}'
      class='button product__mobile-cta-btn'
      {% if current_variant.available == false %}
        disabled
      {% endif %}>
      {%- if current_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</div>

{% render 'product-media-gallery', section_id: section.id %}
{% render 'product-variant-selection', section_id: section.id, product_form_id: product_form_id %}

<style>
  /* ── Main Product — layout & buy-box ── */
  .prod-breadcrumb {
    padding: 12px 0 0;
  }
  .prod-breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--f0);
  }
  .prod-breadcrumb__link {
    color: var(--color-text);
    opacity: 0.6;
    text-decoration: none;
  }
  .prod-breadcrumb__link:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .prod-breadcrumb__current {
    opacity: 0.4;
  }
  .prod-breadcrumb__sep {
    opacity: 0.3;
    display: flex;
    align-items: center;
  }

  /* Rating */
  .product__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }
  .prod-stars {
    display: flex;
    gap: 1px;
  }
  .prod-star {
    font-size: 1rem;
    line-height: 1;
  }
  .prod-star--full,
  .prod-star--half {
    color: #f5a623;
  }
  .prod-star--empty {
    color: var(--color-border);
  }
  .prod-rating-value {
    font-weight: var(--font-heading-weight);
    font-size: var(--f1);
  }
  .prod-rating-count {
    font-size: var(--f0);
    opacity: 0.6;
  }
  .prod-rating-placeholder {
    font-size: var(--f1);
    opacity: 0.5;
  }

  /* Stock */
  .product__stock {
    margin: 6px 0 12px;
  }
  .prod-stock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--f1);
    font-weight: var(--font-heading-weight);
  }
  .prod-stock__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .prod-stock--in .prod-stock__dot {
    background: #22c55e;
  }
  .prod-stock--low .prod-stock__dot {
    background: #f59e0b;
  }
  .prod-stock--out .prod-stock__dot {
    background: var(--color-sale);
  }
  .prod-stock--in {
    color: #16a34a;
  }
  .prod-stock--low {
    color: #b45309;
  }
  .prod-stock--out {
    color: var(--color-sale);
  }

  /* SKU */
  .product__sku {
    font-size: var(--f0);
    opacity: 0.5;
    margin: 0 0 8px;
  }
  .product__sku-label {
    margin-right: 4px;
  }

  /* PIX & Parcelas */
  .product__pix {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--f1);
    margin: 6px 0 0;
    color: var(--color-text);
  }
  .product__pix-badge {
    background: #32bcad;
    color: #fff;
    font-size: var(--f0);
    font-weight: var(--font-heading-weight);
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }
  .product__installments {
    font-size: var(--f1);
    opacity: 0.7;
    margin: 4px 0 0;
  }

  /* Variant cards */
  .product__option-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product__swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    margin: 0;
    border: 1.5px solid var(--color-border);
    border-radius: var(--inputs-radius);
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    background: var(--color-background);
  }
  .product__swatch:hover {
    border-color: var(--color-accent);
  }
  .product__swatch.is-selected {
    border-color: var(--color-accent);
    border-width: 2px;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }
  .product__swatch.is-unavailable {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .product__swatch-label {
    font-size: var(--f1);
    font-weight: var(--font-heading-weight);
  }
  .product__swatch-color,
  .product__swatch-media {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    display: block;
  }

  /* Buy / Purchase */
  .section-main-product {
    --product-button-radius: max(var(--buttons-radius, 4px), 8px);
  }
  .section-main-product .product__title {
    font-family: 'Bungee', sans-serif;
    font-weight: 400;
  }
  .section-main-product .button,
  .section-main-product .product__wishlist,
  .section-main-product .quantity-selector,
  .section-main-product .product__purchase .shopify-payment-button button,
  .section-main-product .product__buy-buttons .shopify-payment-button button {
    border-radius: var(--product-button-radius);
  }
  .product__purchase,
  .product__buy-buttons {
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .product__purchase-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    width: 100%;
  }
  .product__quantity--inline {
    margin: 0;
    flex-shrink: 0;
  }
  .product__quantity--inline .quantity-selector {
    height: 100%;
  }
  .product__quantity--inline .quantity__button,
  .product__quantity--inline .quantity__input {
    height: 52px;
  }
  .product__add-to-cart {
    flex: 1;
    width: auto;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    margin-bottom: 0;
  }
  .product__buy-now {
    flex: 1;
    width: auto;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--f2);
    font-weight: var(--font-heading-weight);
    min-height: 52px;
  }
  .product__buy-now-wrap {
    flex: 1;
    min-width: 0;
  }
  .product__buy-now-wrap .shopify-payment-button,
  .product__buy-now-wrap .shopify-payment-button__button {
    width: 100%;
  }
  .product__wishlist {
    flex-shrink: 0;
    align-self: stretch;
    background: none;
    border: 1.5px solid var(--color-border);
    border-radius: var(--product-button-radius);
    width: 52px;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    color: var(--color-text);
  }
  .product__wishlist:hover,
  .product__wishlist.is-wished {
    border-color: #e11d48;
    color: #e11d48;
  }
  .product__wishlist:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Dynamic checkout override sizing */
  .product__purchase .shopify-payment-button button,
  .product__buy-buttons .shopify-payment-button button {
    min-height: 52px !important;
  }

  /* Descrição: desktop sob a imagem; mobile sob os botões */
  .product__desc-under-info {
    display: none;
  }
  @media screen and (max-width: 1000px) {
    .product__desc-under-media {
      display: none;
    }
    .product__desc-under-info {
      display: block;
    }
  }

  /* Mobile sticky CTA */
  .product__mobile-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
    padding: 10px 0;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  .product__mobile-cta.is-visible {
    transform: translateY(0);
  }
  .product__mobile-cta-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .product__mobile-cta-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .product__mobile-cta-title {
    font-size: var(--f1);
    font-weight: var(--font-heading-weight);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .product__mobile-cta-price .price {
    font-size: var(--f2);
  }
  .product__mobile-cta-btn {
    flex-shrink: 0;
    min-height: 46px;
    font-size: var(--f1);
  }

  @media screen and (min-width: 1001px) {
    .product__mobile-cta {
      display: none !important;
    }
  }
  @media screen and (max-width: 1000px) {
    .product__mobile-cta[hidden] {
      display: none;
    }
  }
</style>

<script>
  ;(function () {
    // Mobile sticky CTA visibility
    var cta = document.getElementById('ProductMobileCTA-{{ section.id }}')
    var buyBtns = document.querySelector('[data-section-id="{{ section.id }}"] .product__buy-buttons')
    if (cta && buyBtns && window.innerWidth <= 1000) {
      cta.removeAttribute('hidden')
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            cta.classList.toggle('is-visible', !entry.isIntersecting)
            cta.setAttribute('aria-hidden', entry.isIntersecting ? 'true' : 'false')
          })
        },
        { threshold: 0.1 }
      )
      observer.observe(buyBtns)
    }

    // Wishlist toggle (placeholder — integrates with any wishlist app via data-product-id)
    var wishBtn = document.querySelector('[data-section-id="{{ section.id }}"] .product__wishlist')
    if (wishBtn) {
      wishBtn.addEventListener('click', function () {
        wishBtn.classList.toggle('is-wished')
        var isWished = wishBtn.classList.contains('is-wished')
        wishBtn.setAttribute('aria-pressed', isWished ? 'true' : 'false')
        document.dispatchEvent(
          new CustomEvent('wishlist:toggle', {
            detail: { productId: wishBtn.dataset.productId, wished: isWished }
          })
        )
      })
    }
  })()
</script>

