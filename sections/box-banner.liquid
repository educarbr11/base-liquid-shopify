{%- comment -%}
  ============================================================
  BOX BANNER
  ============================================================
  Banner responsivo com conteúdo à esquerda (com ícone, título
  em Bungee e botão) e imagem à direita. Inclui um gradiente
  sobre a imagem (esquerda -> direita no desktop, topo -> baixo no mobile)
  para misturar a imagem suavemente com a cor de fundo.
{%- endcomment -%}

<section class='box-banner-wrapper page-width' data-section-id='{{ section.id }}'>
  <div class='box-banner' style='--bg-color: {{ section.settings.bg_color }}; --btn-color: {{ section.settings.btn_color }}; --icon-size: {{ section.settings.icon_size }}px;'>
    <div class='box-banner__content'>
      <div class='box-banner__header'>
        <div class='box-banner__icon-wrapper'>
          {%- if section.settings.icon_image != blank -%}
            <img src='{{ section.settings.icon_image | image_url: width: 80 }}' alt='Icon' class='box-banner__icon-img' loading='lazy'>
          {%- else -%}
            <svg width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.29 7 12 12.01 20.71 7"></polyline>
              <line x1="12" y1="22" x2="12" y2="12"></line>
            </svg>
          {%- endif -%}
        </div>
        {%- if section.settings.title != blank -%}
          <h2 class='box-banner__title'>{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class='box-banner__text'>
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href='{{ section.settings.button_link | default: '#' }}' class='box-banner__btn'>
          {{ section.settings.button_label | escape }}
          <svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class='box-banner__media'>
      {%- if section.settings.image != blank -%}
        {%- assign img_alt = section.settings.title | escape -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'box-banner__image', widths: '400, 600, 800, 1200', alt: img_alt }}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'box-banner__image placeholder-svg' }}
      {%- endif -%}

      <!-- Gradient overlay -->
      <div class='box-banner__gradient'></div>
    </div>
  </div>
</section>

<style>
  .box-banner-wrapper {
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .box-banner {
    display: flex;
    background-color: var(--bg-color, #0b1d3a);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .box-banner__content {
    flex: 0 0 45%;
    padding: 48px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 2;
  }
  .box-banner__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
  }
  .box-banner__icon-wrapper {
    width: var(--icon-size, 72px);
    height: var(--icon-size, 72px);
    border: 3px solid #ffcc00;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(255, 204, 0, 0.05); /* Ligeiro brilho amarelo de fundo */
  }
  .box-banner__icon-wrapper svg {
    width: 36px;
    height: 36px;
    color: #ffcc00;
  }
  .box-banner__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
  }
  .box-banner__title {
    font-family: 'Bungee', cursive;
    font-size: var(--f4, 32px);
    color: #fff;
    line-height: 1.2;
    text-transform: uppercase;
    margin: 0;
  }
  .box-banner__text {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--f2, 18px);
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .box-banner__text p {
    margin: 0;
  }
  .box-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--btn-color, #fa1e2a);
    color: #fff;
    font-family: 'Bungee', cursive;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 10px;
    align-self: flex-start;
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .box-banner__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .box-banner__media {
    flex: 1;
    position: relative;
    background: #0b1d3a;
    min-height: 100%;
  }
  .box-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: center right;
  }
  .box-banner__image.placeholder-svg {
    background-color: #222;
  }

  .box-banner__gradient {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 35%;
    background: linear-gradient(to right, var(--bg-color, #0b1d3a) 0%, transparent 100%);
    pointer-events: none;
  }

  @media screen and (max-width: 900px) {
    .box-banner {
      flex-direction: column;
    }
    .box-banner__content {
      flex: auto;
      padding: 40px 24px;
    }
    .box-banner__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .box-banner__icon-wrapper {
      width: calc(var(--icon-size) * 0.85);
      height: calc(var(--icon-size) * 0.85);
    }
    .box-banner__title {
      font-size: var(--f3, 24px);
    }
    .box-banner__text {
      font-size: var(--f1, 15px);
      margin-bottom: 32px;
    }
    .box-banner__btn {
      width: 100%;
      padding: 14px 20px;
    }

    .box-banner__media {
      min-height: auto;
      height: auto;
      display: flex;
      order: 1; /* Forçar ordem no caso de invertemos; embora já esteja em baixo na marcação HTML */
    }
    .box-banner__image {
      height: auto;
      object-fit: cover;
    }

    /* No mobile, gradient vai de cima para baixo */
    .box-banner__gradient {
      top: -1px;
      left: 0;
      right: 0;
      bottom: auto;
      width: 100%;
      height: 35%;
      background: linear-gradient(to bottom, var(--bg-color, #0b1d3a) 0%, transparent 100%);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bannerWrapper = document.querySelector('[data-section-id="{{ section.id }}"] .box-banner')
    if (!bannerWrapper) return

    if (window.gsap && window.IntersectionObserver) {
      // Define initial state in JS to prevent theme editor bugs
      gsap.set(bannerWrapper, { opacity: 0, y: 30 })

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              gsap.to(bannerWrapper, {
                y: 0,
                opacity: 1,
                duration: 0.8,
                ease: 'power3.out',
                clearProps: 'all'
              })
              obs.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.1 }
      )
      observer.observe(bannerWrapper)
    }
  })
</script>

{% schema %}
{
  "name": "Box Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de Fundo",
      "default": "#061A3D"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Cor do Botão",
      "default": "#FB1F2A"
    },
    {
      "type": "header",
      "content": "Conteúdo (Esquerda)"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Ícone do Título",
      "info": "Deixe em branco para usar o ícone padrão de caixa amarela."
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Tamanho da Caixa do Ícone",
      "default": 72
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "CONHEÇA NOSSOS BOX'S"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição",
      "default": "<p>Adquira todos os volumes da coleção em um único Box e tenha acesso a uma metodologia inovadora que integra livros didáticos, tecnologia, pensamento computacional, programação, robótica e recursos digitais exclusivos.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do Botão",
      "default": "CONHECER BOX'S"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do Botão"
    },
    {
      "type": "header",
      "content": "Mídia (Direita)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem da Coleção",
      "info": "Imagem retangular com produtos/boxs. O gradiente cuidará da fusão com o fundo."
    }
  ],
  "presets": [
    {
      "name": "Box Banner"
    }
  ]
}
{% endschema %}
