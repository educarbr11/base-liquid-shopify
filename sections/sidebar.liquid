{%- comment -%}
  ============================================================
  SIDEBAR — navegação lateral fixa
  ============================================================
{%- endcomment -%}
<aside class="sidebar" id="Sidebar-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="sidebar__inner">
    {%- comment -%} Header / Logo + Toggle {%- endcomment -%}
    <div class="sidebar__header">
      <a href="{{ routes.root_url }}" class="sidebar__logo-link">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {{
            settings.logo
            | image_url: width: 300
            | image_tag:
              class: 'sidebar__logo-image',
              widths: '100, 150, 200, 300',
              width: 120,
              height: 120 | divided_by: settings.logo.aspect_ratio,
              alt: logo_alt
          }}
        {%- else -%}
          <span class="sidebar__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      
      <button class="sidebar__close-btn tap-target" aria-label="Recolher menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
    </div>

    {%- comment -%} Menu Principal {%- endcomment -%}
    <nav class="sidebar__nav" aria-label="Menu principal">
      <ul class="sidebar__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="sidebar__menu-item">
            <a href="{{ link.url }}" class="sidebar__menu-link {% if link.active or link.child_active %}sidebar__menu-link--active{% endif %}">
              <div class="sidebar__icon-box">
                {%- if link.title contains 'Início' or link.title contains 'Home' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {%- elsif link.title contains 'Categorias' or link.title contains 'Catalog' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c-2.28 0-3-2-3-3s2-4 2-4-1 2-1 3.5c0 1.22 1.39 2 2.5 2s2.5-.78 2.5-2 1-3.5 1-3.5-2 2-2 4c0 1 1 3 3 3a2.5 2.5 0 0 1-5 5c-1.1 0-2-.9-2-2Z"/></svg>
                {%- elsif link.title contains 'Lançamentos' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg>
                {%- endif -%}
              </div>
              <span class="sidebar__menu-name">{{ link.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Categorias / Coleções Hardcoded - Conforme Layout {%- endcomment -%}
    <div class="sidebar__collections">
      <h3 class="sidebar__collections-title">COLEÇÕES</h3>
      <ul class="sidebar__collections-list" role="list">
        
        <li class="sidebar__collections-item">
          <a href="#" class="sidebar__collections-link">
            <div class="sidebar__icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 13a6 6 0 1 0 12 0 4 4 0 1 0-8 0 2 2 0 1 0 4 0"/><path d="M20 13v-4a2 2 0 0 0-2-2h-3"/><path d="M20 4v5"/><path d="M17 4v5"/></svg>
            </div>
            <span class="sidebar__collections-name">Pré-Escola</span>
            <span class="sidebar__collections-count">4</span>
          </a>
        </li>

        <li class="sidebar__collections-item">
          <a href="#" class="sidebar__collections-link">
            <div class="sidebar__icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="8" cy="12" r="2"/><circle cx="16" cy="12" r="2"/></svg>
            </div>
            <span class="sidebar__collections-name">Edu Digital</span>
            <span class="sidebar__collections-count">10</span>
          </a>
        </li>

        <li class="sidebar__collections-item">
          <a href="#" class="sidebar__collections-link">
            <div class="sidebar__icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>
            </div>
            <span class="sidebar__collections-name">Pensamento Computacional</span>
            <span class="sidebar__collections-count">8</span>
          </a>
        </li>

        <li class="sidebar__collections-item">
          <a href="#" class="sidebar__collections-link">
            <div class="sidebar__icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 9v6"/><path d="M14 9v6"/><path d="M2 13a6 6 0 1 0 12 0 4 4 0 1 0-8 0 2 2 0 1 0 4 0"/><path d="M22 13a6 6 0 1 0-12 0 4 4 0 1 0 8 0 2 2 0 1 0-4 0"/></svg>
            </div>
            <span class="sidebar__collections-name">Robótica Educacional</span>
            <span class="sidebar__collections-count">8</span>
          </a>
        </li>

        <li class="sidebar__collections-item">
          <a href="#" class="sidebar__collections-link sidebar__collections-link--active">
            <div class="sidebar__icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M2 12c0-5 6-7 10-7s10 2 10 7-6 7-10 7-10-2-10-7z"/></svg>
            </div>
            <span class="sidebar__collections-name">OBA</span>
            <span class="sidebar__collections-count">3</span>
          </a>
        </li>

      </ul>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 260px;
    height: 100vh;
    background: #0B1D3A;
    color: #ffffff;
    z-index: 250;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(255,255,255,0.08);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.2) transparent;
    transition: transform 0.3s ease;
  }
  @media screen and (max-width: 1366px) {
    .sidebar { width: 240px; }
  }
  .sidebar__inner {
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
  }
  
  /* Header */
  .sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sidebar__logo-link {
    display: block;
    text-decoration: none;
    color: #ffffff;
  }
  .sidebar__logo-image {
    display: block;
    max-width: 140px;
    height: auto;
  }
  .sidebar__logo-text {
    font-family: var(--font-heading-family);
    font-size: var(--f4);
    font-weight: 700;
  }
  .sidebar__close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #E8A817;
    color: #0B1D3A;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .sidebar__close-btn:hover { background: #d69b14; }
  .sidebar__close-btn svg { width: 22px; height: 22px; }

  /* Base nav item styles */
  .sidebar__menu-link, .sidebar__collections-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 14px 6px 6px;
    border-radius: 12px;
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  
  /* Menu principal */
  .sidebar__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar__menu-link .sidebar__icon-box {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: #E8A817; 
    color: #0B1D3A; 
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .sidebar__menu-link:hover {
    background: rgba(255,255,255,0.06);
  }
  .sidebar__menu-link--active {
    background: #E8A817;
    color: #0B1D3A;
  }
  .sidebar__menu-link--active .sidebar__icon-box {
    background: transparent;
    color: #0B1D3A;
  }
  .sidebar__menu-link--active:hover {
    background: #d69b14;
  }
  
  /* Coleções */
  .sidebar__collections-title {
    font-family: var(--font-heading-family);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ffffff;
    margin: 0 0 14px 10px;
  }
  .sidebar__collections-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar__collections-link .sidebar__icon-box {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid #E8A817;
    background: transparent;
    color: #E8A817;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .sidebar__collections-link:hover {
    background: rgba(255,255,255,0.06);
  }
  .sidebar__collections-link--active {
    background: #E8A817;
    color: #0B1D3A;
  }
  .sidebar__collections-link--active .sidebar__icon-box {
    border-color: #0B1D3A;
    color: #0B1D3A;
  }
  .sidebar__collections-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sidebar__collections-count {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    background: transparent;
  }
  .sidebar__collections-link--active .sidebar__collections-count {
    color: #0B1D3A;
  }

  /* Global icon size */
  .sidebar__icon-box svg {
    width: 22px;
    height: 22px;
  }

  /* Mobile & Tablet Drawer */
  @media screen and (max-width: 1024px) {
    .sidebar {
      top: 0;
      height: 100vh;
      transform: translateX(-100%);
      z-index: 250;
      width: 280px;
    }
    .sidebar.sidebar--open {
      transform: translateX(0);
    }
  }
</style>

<script>
  (function() {
    var closeBtn = document.querySelector('.sidebar__close-btn');
    var sidebar = document.querySelector('.sidebar');
    
    // For handling collapse (desktop vs mobile)
    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', function() {
        if (window.innerWidth <= 1024) {
          sidebar.classList.remove('sidebar--open');
          var overlay = document.querySelector('.sidebar-overlay');
          if (overlay) {
            overlay.style.opacity = '0';
            setTimeout(function() { overlay.style.display = 'none'; }, 300);
          }
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Sidebar",
  "class": "section-sidebar",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu principal"
    }
  ]
}
{% endschema %}
