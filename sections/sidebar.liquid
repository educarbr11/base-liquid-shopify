{%- comment -%}
  ============================================================
  SIDEBAR — navegação lateral fixa
  ============================================================
{%- endcomment -%}
<aside class='sidebar' id='Sidebar-{{ section.id }}' data-section-id='{{ section.id }}'>
  <div class='sidebar__inner'>
    {%- comment -%} Header / Logo + Toggle {%- endcomment -%}
    <div class='sidebar__header'>
      <a href='{{ routes.root_url }}' class='sidebar__logo-link'>
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {%- assign logo_height = 120 | divided_by: settings.logo.aspect_ratio | round -%}
          {{ settings.logo | image_url: width: 300 | image_tag: class: 'sidebar__logo-image', widths: '100, 150, 200, 300', width: 120, height: logo_height, alt: logo_alt }}
        {%- else -%}
          <span class='sidebar__logo-text'>{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <button class='sidebar__close-btn tap-target' aria-label='Recolher menu'>
        <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Menu Principal {%- endcomment -%}
    <nav class='sidebar__nav' aria-label='Menu principal'>
      <ul class='sidebar__menu' role='list'>
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_link' -%}
            <li class='sidebar__menu-item' {{ block.shopify_attributes }}>
              <a href='{{ block.settings.link | default: '#' }}' class='sidebar__menu-link {% if request.path == block.settings.link %}sidebar__menu-link--active{% endif %}'>
                <div class='sidebar__icon-box'>
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- elsif block.settings.icon_image != blank -%}
                    <img src='{{ block.settings.icon_image | image_url: width: 60 }}' width='24' height='24' style='width:24px; height:24px; object-fit:contain;' alt=''>
                  {%- endif -%}
                </div>
                <span class='sidebar__menu-name'>{{ block.settings.title | escape }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Categorias / Coleções Editáveis {%- endcomment -%}
    <div class='sidebar__collections'>
      <h3 class='sidebar__collections-title'>COLEÇÕES</h3>
      <ul class='sidebar__collections-list' role='list'>
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_link' -%}
            {%- assign col = block.settings.collection -%}
            {%- assign link_title = block.settings.title | default: col.title | default: 'Nova Coleção' -%}
            {%- if block.settings.title == blank and col == blank -%}{%- assign link_title = 'Nova Coleção' -%}{%- endif -%}

            <li class='sidebar__collections-item' {{ block.shopify_attributes }}>
              <a href='{{ col.url | default: '#' }}' class='sidebar__collections-link {% if collection and collection.handle == col.handle %}sidebar__collections-link--active{% endif %}'>
                <div class='sidebar__icon-box'>
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- elsif block.settings.icon_image != blank -%}
                    <img src='{{ block.settings.icon_image | image_url: width: 60 }}' width='24' height='24' style='width:24px; height:24px; object-fit:contain;' alt=''>
                  {%- endif -%}
                </div>
                <span class='sidebar__collections-name'>{{ link_title | escape }}</span>
                {%- if col and col.all_products_count >= 0 -%}
                  <span class='sidebar__collections-count'>{{ col.all_products_count }}</span>
                {%- else -%}
                  {%- comment -%} Fallback count se a coleção não existe ainda {%- endcomment -%}
                  <span class='sidebar__collections-count'>{{ block.settings.fallback_count | default: '0' }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 260px;
    height: 100vh;
    background: #0b1d3a;
    color: #ffffff;
    z-index: 250;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    transition: transform 0.3s ease;
  }
  @media screen and (max-width: 1366px) {
    .sidebar {
      width: 240px;
    }
  }
  .sidebar__inner {
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
  }

  /* Header */
  .sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sidebar__logo-link {
    display: block;
    text-decoration: none;
    color: #ffffff;
  }
  .sidebar__logo-image {
    display: block;
    max-width: 140px;
    height: auto;
  }
  .sidebar__logo-text {
    font-family: var(--font-heading-family);
    font-size: var(--f4);
    font-weight: 700;
  }
  .sidebar__close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #e8a817;
    color: #0b1d3a;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .sidebar__close-btn:hover {
    background: #d69b14;
  }
  .sidebar__close-btn svg {
    width: 22px;
    height: 22px;
  }
  @media screen and (min-width: 1025px) {
    .sidebar__close-btn {
      display: none;
    }
  }

  /* Base nav item styles */
  .sidebar__menu-link,
  .sidebar__collections-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 2px 14px 2px 2px;
    border-radius: 12px;
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  /* Menu principal */
  .sidebar__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar__menu-link .sidebar__icon-box {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: #e8a817;
    color: #0b1d3a;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .sidebar__menu-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .sidebar__menu-link--active {
    background: #e8a817;
    color: #0b1d3a;
  }
  .sidebar__menu-link--active .sidebar__icon-box {
    background: transparent;
    color: #0b1d3a;
  }
  .sidebar__menu-link--active:hover {
    background: #d69b14;
  }

  /* Coleções */
  .sidebar__collections-title {
    font-family: var(--font-heading-family);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ffffff;
    margin: 0 0 14px 10px;
  }
  .sidebar__collections-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar__collections-link .sidebar__icon-box {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid #e8a817;
    background: transparent;
    color: #e8a817;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .sidebar__collections-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .sidebar__collections-link--active {
    background: #e8a817;
    color: #0b1d3a;
  }
  .sidebar__collections-link--active .sidebar__icon-box {
    border-color: #f5be18;
    color: #0b1d3a;
    background: #042757;
  }
  .sidebar__collections-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sidebar__collections-count {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    background: transparent;
  }
  .sidebar__collections-link--active .sidebar__collections-count {
    color: #0b1d3a;
  }

  /* Global icon size */
  .sidebar__icon-box svg {
    width: 22px;
    height: 22px;
  }

  /* Mobile & Tablet Drawer */
  @media screen and (max-width: 1024px) {
    .sidebar {
      top: 0;
      height: 100vh;
      transform: translateX(-100%);
      z-index: 250;
      width: 280px;
    }
    .sidebar.sidebar--open {
      transform: translateX(0);
    }
  }
</style>

<script>
  ;(function () {
    var closeBtn = document.querySelector('.sidebar__close-btn')
    var sidebar = document.querySelector('.sidebar')

    // For handling collapse (desktop vs mobile)
    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', function () {
        if (window.innerWidth <= 1024) {
          sidebar.classList.remove('sidebar--open')
          var overlay = document.querySelector('.sidebar-overlay')
          if (overlay) {
            overlay.style.opacity = '0'
            setTimeout(function () {
              overlay.style.display = 'none'
            }, 300)
          }
        }
      })
    }
  })()
</script>

{% schema %}
{
  "name": "Sidebar",
  "class": "section-sidebar",
  "settings": [],
  "blocks": [
    {
      "type": "menu_link",
      "name": "Link Principal",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Link" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "html", "id": "icon", "label": "Ícone SVG (Recomendado)", "info": "Cole o código do SVG aqui para que as cores troquem automaticamente no hover." },
        { "type": "image_picker", "id": "icon_image", "label": "Ou envie uma imagem (PNG/JPG)" }
      ]
    },
    {
      "type": "collection_link",
      "name": "Link de Coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção Vinculada" },
        { "type": "text", "id": "title", "label": "Título alternativo (opcional)", "info": "Se vazio, usa o nome da coleção." },
        { "type": "html", "id": "icon", "label": "Ícone SVG (Recomendado)", "info": "Cole o código do SVG aqui para que as cores troquem automaticamente no hover." },
        { "type": "image_picker", "id": "icon_image", "label": "Ou envie uma imagem (PNG/JPG)" },
        { "type": "text", "id": "fallback_count", "label": "Contagem Fictícia (se sem coleção)", "default": "0" }
      ]
    }
  ]
}
{% endschema %}
