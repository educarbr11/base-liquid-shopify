{%- comment -%}
  ============================================================
  NAVEGAÇÃO PRINCIPAL — horizontal no desktop e gaveta no mobile
  ============================================================
{%- endcomment -%}
<aside class='sidebar' id='SiteNavigation' data-section-id='{{ section.id }}'>
  <div class='sidebar__inner'>
    {%- comment -%} Header / Logo + Toggle {%- endcomment -%}
    <div class='sidebar__header'>
      <a href='{{ routes.root_url }}' class='sidebar__logo-link'>
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {%- assign logo_height = 120 | divided_by: settings.logo.aspect_ratio | round -%}
          {{ settings.logo | image_url: width: 300 | image_tag: class: 'sidebar__logo-image', widths: '100, 150, 200, 300', width: 120, height: logo_height, alt: logo_alt }}
        {%- else -%}
          <span class='sidebar__logo-text'>{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <button class='sidebar__close-btn tap-target' type='button' aria-label='Fechar menu'>
        <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Menu Principal {%- endcomment -%}
    <nav class='sidebar__nav' aria-label='Menu principal'>
      <ul class='sidebar__menu' role='list'>
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_link' -%}
            <li class='sidebar__menu-item' {{ block.shopify_attributes }}>
              <a href='{{ block.settings.link | default: '#' }}' class='sidebar__menu-link {% if request.path == block.settings.link %}sidebar__menu-link--active{% endif %}'>
                <div class='sidebar__icon-box'>
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- elsif block.settings.icon_image != blank -%}
                    <img src='{{ block.settings.icon_image | image_url: width: 60 }}' width='24' height='24' style='width:24px; height:24px; object-fit:contain;' alt=''>
                  {%- endif -%}
                </div>
                <span class='sidebar__menu-name'>{{ block.settings.title | escape }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Categorias de ensino e coleções configuráveis no editor {%- endcomment -%}
    {%- assign education_stages = 'educacao_infantil|Educação Infantil,fundamental_i|Fundamental I,fundamental_ii|Fundamental II,paradidatico|Paradidático' | split: ',' -%}
    <div class='sidebar__stages'>
      {%- for stage_item in education_stages -%}
        {%- assign stage_data = stage_item | split: '|' -%}
        {%- assign stage_key = stage_data[0] -%}
        {%- assign stage_title = stage_data[1] -%}
        {%- assign stage_is_active = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_link' and block.settings.stage == stage_key and collection and block.settings.collection.handle == collection.handle -%}
            {%- assign stage_is_active = true -%}
          {%- endif -%}
        {%- endfor -%}

        <details class='sidebar__stage{% if stage_is_active %} sidebar__stage--active{% endif %}' data-stage>
          <summary class='sidebar__stage-title'>
            <span>{{ stage_title }}</span>
            <svg width='16' height='16' viewBox='0 0 16 16' fill='none' aria-hidden='true'><path d='m4 6 4 4 4-4' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>
          </summary>
          <ul class='sidebar__collections-list' role='list'>
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection_link' and block.settings.stage == stage_key -%}
                {%- assign col = block.settings.collection -%}
                {%- assign link_title = block.settings.title | default: col.title | default: 'Nova Coleção' -%}
                <li class='sidebar__collections-item' {{ block.shopify_attributes }}>
                  {%- if col != blank -%}
                    <a href='{{ col.url }}' class='sidebar__collections-link{% if collection and collection.handle == col.handle %} sidebar__collections-link--active{% endif %}'{% if collection and collection.handle == col.handle %} aria-current='page'{% endif %}>
                      <span class='sidebar__icon-box'>
                        {%- if block.settings.icon != blank -%}
                          {{ block.settings.icon }}
                        {%- elsif block.settings.icon_image != blank -%}
                          {{ block.settings.icon_image | image_url: width: 60 | image_tag: width: 24, height: 24, loading: 'lazy', alt: '' }}
                        {%- endif -%}
                      </span>
                      <span class='sidebar__collections-name'>{{ link_title | escape }}</span>
                      <span class='sidebar__collections-count'>{{ col.all_products_count }}</span>
                    </a>
                  {%- else -%}
                    <span class='sidebar__collections-link sidebar__collections-link--disabled' aria-disabled='true'>
                      <span class='sidebar__icon-box'>
                        {%- if block.settings.icon != blank -%}
                          {{ block.settings.icon }}
                        {%- elsif block.settings.icon_image != blank -%}
                          {{ block.settings.icon_image | image_url: width: 60 | image_tag: width: 24, height: 24, loading: 'lazy', alt: '' }}
                        {%- endif -%}
                      </span>
                      <span class='sidebar__collections-name'>{{ link_title | escape }}</span>
                      <span class='sidebar__collections-status'>Em breve</span>
                    </span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </details>
      {%- endfor -%}
    </div>
  </div>
</aside>

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 190;
    overflow: visible !important;
  }

  .sidebar {
    position: fixed;
    top: 70px;
    left: 0;
    width: 100%;
    height: 54px;
    background: var(--color-background, #ffffff);
    color: var(--color-text, #0b1d3a);
    z-index: 190;
    overflow: visible;
    border-bottom: 1px solid var(--color-border, #d9dde5);
    box-shadow: 0 4px 14px rgba(11, 29, 58, 0.08);
    transition: transform 0.3s ease;
  }
  .sidebar__inner {
    width: 100%;
    max-width: var(--page-width, 1200px);
    height: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Header */
  .sidebar__header {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sidebar__logo-link {
    display: block;
    text-decoration: none;
    color: #ffffff;
  }
  .sidebar__logo-image {
    display: block;
    max-width: 140px;
    height: auto;
  }
  .sidebar__logo-text {
    font-family: var(--font-heading-family);
    font-size: var(--f4);
    font-weight: 700;
  }
  .sidebar__close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #e8a817;
    color: #0b1d3a;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .sidebar__close-btn:hover {
    background: #d69b14;
  }
  .sidebar__close-btn svg {
    width: 22px;
    height: 22px;
  }
  @media screen and (min-width: 1025px) {
    .sidebar__close-btn {
      display: none;
    }
  }

  /* Base nav item styles */
  .sidebar__menu-link,
  .sidebar__collections-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 10px;
    color: var(--color-text, #0b1d3a);
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  /* Menu principal */
  .sidebar__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sidebar__menu-link .sidebar__icon-box {
    display: none;
  }
  .sidebar__menu-link:hover {
    background: var(--color-background-contrast, #f2f3f8);
  }
  .sidebar__menu-link--active {
    background: #e8a817;
    color: #0b1d3a;
  }
  .sidebar__menu-link--active .sidebar__icon-box {
    background: transparent;
    color: #0b1d3a;
  }
  .sidebar__menu-link--active:hover {
    background: #d69b14;
  }

  /* Coleções */
  .sidebar__stages {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }
  .sidebar__stage {
    position: relative;
    flex-shrink: 0;
  }
  .sidebar__stage-title {
    font-family: var(--font-heading-family);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: var(--color-text, #0b1d3a);
    margin: 0;
    padding: 9px 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 10px;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .sidebar__stage-title::-webkit-details-marker { display: none; }
  .sidebar__stage-title:hover,
  .sidebar__stage[open] .sidebar__stage-title,
  .sidebar__stage--active .sidebar__stage-title { background: var(--color-background-contrast, #f2f3f8); }
  .sidebar__stage--active .sidebar__stage-title { color: var(--color-accent, #ff0033); }
  .sidebar__stage-title svg { flex-shrink: 0; transition: transform 0.2s ease; }
  .sidebar__stage[open] .sidebar__stage-title svg { transform: rotate(180deg); }
  .sidebar__stage[open]::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 12px;
  }
  .sidebar__collections-list {
    list-style: none;
    margin: 0;
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    width: min(340px, calc(100vw - 40px));
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-background, #ffffff);
    border: 1px solid var(--color-border, #d9dde5);
    border-radius: 18px;
    box-shadow: 0 18px 44px rgba(11, 29, 58, 0.18);
  }
  .sidebar__stage:last-child .sidebar__collections-list { right: 0; left: auto; }
  .sidebar__collections-link .sidebar__icon-box {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid #e8a817;
    background: transparent;
    color: #e8a817;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .sidebar__collections-link:hover {
    background: var(--color-background-contrast, #f2f3f8);
  }
  .sidebar__collections-link--disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .sidebar__collections-link--disabled:hover { background: transparent; }
  .sidebar__collections-link--active {
    background: #e8a817;
    color: #0b1d3a;
  }
  .sidebar__collections-link--active .sidebar__icon-box {
    border-color: #f5be18;
    color: #0b1d3a;
    background: #042757;
  }
  .sidebar__collections-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sidebar__collections-count {
    color: var(--color-text, #0b1d3a);
    font-size: 0.85rem;
    font-weight: 800;
    background: transparent;
  }
  .sidebar__collections-status {
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .sidebar__collections-link--active .sidebar__collections-count {
    color: #0b1d3a;
  }

  /* Global icon size */
  .sidebar__icon-box svg {
    width: 22px;
    height: 22px;
  }

  @media screen and (min-width: 1025px) and (max-width: 1200px) {
    .sidebar__inner { gap: 6px; padding-inline: 12px; }
    .sidebar__menu-link { padding-inline: 8px; font-size: 0.86rem; }
    .sidebar__stage-title { padding-inline: 7px; font-size: 0.65rem; letter-spacing: 0.35px; }
  }

  /* Mobile & Tablet Drawer */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} {
      z-index: 250;
    }
    .sidebar {
      top: 0;
      width: min(320px, 88vw);
      height: 100dvh;
      padding: 0;
      overflow-y: auto;
      background: #0b1d3a;
      color: #ffffff;
      transform: translateX(-100%);
      visibility: hidden;
      pointer-events: none;
      z-index: 250;
      border: 0;
      box-shadow: 16px 0 40px rgba(0, 0, 0, 0.24);
      transition: transform 0.3s ease, visibility 0s linear 0.3s;
    }
    .sidebar.sidebar--open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }
    .sidebar__inner {
      height: auto;
      min-height: 100%;
      padding: 20px 16px 28px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }
    .sidebar__header { display: flex; }
    .sidebar__nav { width: 100%; }
    .sidebar__menu { align-items: stretch; flex-direction: column; gap: 8px; }
    .sidebar__menu-link,
    .sidebar__collections-link { color: #ffffff; padding: 3px 12px 3px 3px; }
    .sidebar__menu-link .sidebar__icon-box { display: flex; }
    .sidebar__menu-link:hover,
    .sidebar__collections-link:hover { background: rgba(255, 255, 255, 0.08); }
    .sidebar__collections-link--disabled:hover { background: transparent; }
    .sidebar__stages {
      width: 100%;
      margin-left: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .sidebar__stage { position: static; }
    .sidebar__stage[open]::after { display: none; }
    .sidebar__stage-title {
      width: 100%;
      justify-content: space-between;
      padding: 12px 10px;
      color: #ffffff;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 0;
    }
    .sidebar__stage-title:hover,
    .sidebar__stage[open] .sidebar__stage-title,
    .sidebar__stage--active .sidebar__stage-title { background: rgba(255, 255, 255, 0.08); }
    .sidebar__stage--active .sidebar__stage-title { color: #e8a817; }
    .sidebar__collections-list {
      position: static;
      width: 100%;
      margin-top: 8px;
      padding: 0;
      display: flex;
      flex-direction: column;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .sidebar__collections-count { color: #ffffff; }
    .sidebar__collections-status { color: #ffffff; }
  }
</style>

<script>
  ;(function () {
    var closeBtn = document.querySelector('.sidebar__close-btn')
    var sidebar = document.querySelector('.sidebar')
    var stages = sidebar ? Array.prototype.slice.call(sidebar.querySelectorAll('[data-stage]')) : []

    function closeStages(exception) {
      stages.forEach(function (stage) {
        if (stage !== exception) stage.removeAttribute('open')
      })
    }

    function resetMobileNavigation() {
      if (!sidebar) return
      sidebar.classList.remove('sidebar--open')
      sidebar.setAttribute('aria-hidden', window.innerWidth <= 1024 ? 'true' : 'false')
      closeStages()
      var overlay = document.querySelector('.sidebar-overlay')
      if (overlay) {
        overlay.style.opacity = '0'
        setTimeout(function () { overlay.style.display = 'none' }, 300)
      }
      var toggle = document.querySelector('.topbar__menu-toggle')
      if (toggle) toggle.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
    }

    // For handling collapse (desktop vs mobile)
    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', function () {
        if (window.innerWidth <= 1024) {
          resetMobileNavigation()
        }
      })
    }

    stages.forEach(function (stage) {
      stage.addEventListener('toggle', function () {
        if (stage.open) closeStages(stage)
      })
      stage.addEventListener('mouseenter', function () {
        if (window.innerWidth > 1024) {
          closeStages(stage)
          stage.setAttribute('open', '')
        }
      })
      stage.addEventListener('mouseleave', function () {
        if (window.innerWidth > 1024 && !stage.contains(document.activeElement)) {
          stage.removeAttribute('open')
        }
      })
      stage.addEventListener('focusin', function () {
        if (window.innerWidth > 1024) {
          closeStages(stage)
          stage.setAttribute('open', '')
        }
      })
      stage.addEventListener('focusout', function () {
        setTimeout(function () {
          if (window.innerWidth > 1024 && !stage.contains(document.activeElement)) {
            stage.removeAttribute('open')
          }
        }, 0)
      })
    })

    document.addEventListener('click', function (event) {
      if (window.innerWidth > 1024 && sidebar && !sidebar.contains(event.target)) closeStages()
    })

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return
      closeStages()
      if (window.innerWidth <= 1024 && sidebar && sidebar.classList.contains('sidebar--open')) {
        resetMobileNavigation()
      }
    })

    window.addEventListener('resize', function () {
      if (window.innerWidth > 1024 && sidebar && sidebar.classList.contains('sidebar--open')) {
        resetMobileNavigation()
      }
      if (window.innerWidth > 1024) {
        sidebar.setAttribute('aria-hidden', 'false')
        closeStages()
      } else if (!sidebar.classList.contains('sidebar--open')) {
        sidebar.setAttribute('aria-hidden', 'true')
      }
    })
  })()
</script>

{% schema %}
{
  "name": "Navegação principal",
  "class": "section-sidebar",
  "settings": [],
  "blocks": [
    {
      "type": "menu_link",
      "name": "Link Principal",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Link" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "html", "id": "icon", "label": "Ícone SVG (Recomendado)", "info": "Cole o código do SVG aqui para que as cores troquem automaticamente no hover." },
        { "type": "image_picker", "id": "icon_image", "label": "Ou envie uma imagem (PNG/JPG)" }
      ]
    },
    {
      "type": "collection_link",
      "name": "Link de Coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção Vinculada" },
        {
          "type": "select",
          "id": "stage",
          "label": "Categoria / etapa de ensino",
          "default": "educacao_infantil",
          "options": [
            { "value": "educacao_infantil", "label": "Educação Infantil" },
            { "value": "fundamental_i", "label": "Fundamental I" },
            { "value": "fundamental_ii", "label": "Fundamental II" },
            { "value": "paradidatico", "label": "Paradidático" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título alternativo (opcional)", "info": "Se vazio, usa o nome da coleção." },
        { "type": "html", "id": "icon", "label": "Ícone SVG (Recomendado)", "info": "Cole o código do SVG aqui para que as cores troquem automaticamente no hover." },
        { "type": "image_picker", "id": "icon_image", "label": "Ou envie uma imagem (PNG/JPG)" },
        { "type": "text", "id": "fallback_count", "label": "Contagem Fictícia (se sem coleção)", "default": "0" }
      ]
    }
  ]
}
{% endschema %}
