{%- comment -%}
  ============================================================
  TOPBAR — barra superior com busca, login e carrinho
  ============================================================

  O QUE FAZ:
  Header horizontal no topo da área de conteúdo (à direita da
  sidebar). Contém: botão hambúrguer (mobile), barra de busca e
  botões de entrar/cadastro + carrinho.
{%- endcomment -%}
<header class="topbar" data-section-id="{{ section.id }}">
  <button
    type="button"
    class="topbar__menu-toggle tap-target"
    aria-label="Abrir menu"
    aria-expanded="false"
    aria-controls="Sidebar-{{ section.id }}"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>

  <form action="{{ routes.search_url }}" method="get" role="search" class="topbar__search">
    <svg class="topbar__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Pesquisar produto"
      aria-label="Pesquisar produtos"
      class="topbar__search-input"
      autocomplete="off"
    >
  </form>

  <div class="topbar__actions">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="topbar__action-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Entrar/Cadastro</span>
      </a>
    {%- else -%}
      <a href="{{ routes.account_url }}" class="topbar__action-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Entrar/Cadastro</span>
      </a>
    {%- endif -%}

    <a href="{{ routes.cart_url }}" class="topbar__cart tap-target" aria-label="Carrinho"{% if settings.cart_type == 'drawer' %} data-cart-drawer-open aria-haspopup="dialog" aria-controls="carrinho" aria-expanded="false"{% endif %}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
      <span class="topbar__cart-count" data-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 260px;
    width: calc(100% - 260px);
    height: 70px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 24px;
    background: #0B1D3A;
    color: #ffffff;
    z-index: 200;
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
  }

  @media screen and (max-width: 1366px) {
    .topbar {
      left: 240px;
      width: calc(100% - 240px);
    }
  }

  /* Hamburger — mobile only */
  .topbar__menu-toggle {
    display: none;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 4px;
  }

  /* Search */
  .topbar__search {
    flex: 1;
    max-width: 420px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .topbar__search-icon {
    position: absolute;
    left: 12px;
    color: rgba(255,255,255,0.5);
    pointer-events: none;
  }
  .topbar__search-input {
    width: 100%;
    padding: 10px 14px 10px 40px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px;
    background: rgba(255,255,255,0.08);
    color: #ffffff;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .topbar__search-input::placeholder {
    color: rgba(255,255,255,0.45);
  }
  .topbar__search-input:focus {
    border-color: #E8A817;
    background: rgba(255,255,255,0.12);
  }

  /* Actions */
  .topbar__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }
  .topbar__action-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    white-space: nowrap;
    transition: opacity 0.2s;
  }
  .topbar__action-link:hover {
    opacity: 0.8;
  }

  /* Cart */
  .topbar__cart {
    position: relative;
    color: #ffffff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .topbar__cart-count {
    position: absolute;
    top: -4px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    color: #0B1D3A;
    background-color: #E8A817;
    border-radius: 9px;
  }

  @media screen and (max-width: 1024px) {
    .topbar {
      left: 0;
      width: 100%;
      height: 60px;
      padding: 0 16px;
    }
    .topbar__menu-toggle {
      display: inline-flex;
    }
    .topbar__action-link span {
      display: none;
    }
  }
</style>

<script>
(function () {
  var topbar = document.querySelector('.topbar[data-section-id="{{ section.id }}"]');
  if (!topbar) return;
  var toggle = topbar.querySelector('.topbar__menu-toggle');
  var sidebar = document.querySelector('.sidebar');
  var overlay;

  function createOverlay() {
    overlay = document.createElement('div');
    overlay.className = 'sidebar-overlay';
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:140;opacity:0;transition:opacity .3s;display:none;';
    document.body.appendChild(overlay);
    overlay.addEventListener('click', closeSidebar);
  }

  function openSidebar() {
    if (!overlay) createOverlay();
    sidebar.classList.add('sidebar--open');
    overlay.style.display = 'block';
    requestAnimationFrame(function () { overlay.style.opacity = '1'; });
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar.classList.remove('sidebar--open');
    if (overlay) { overlay.style.opacity = '0'; setTimeout(function () { overlay.style.display = 'none'; }, 300); }
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (toggle && sidebar) {
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      if (open) closeSidebar(); else openSidebar();
    });
  }
})();
</script>

{% schema %}
{
  "name": "Topbar",
  "class": "section-topbar"
}
{% endschema %}
