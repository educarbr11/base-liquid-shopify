{%- comment -%}
  ============================================================
  IMAGE BANNER — banner hero com imagem de fundo
  ============================================================
  Banner redesenhado com fundo vermelho/curvo, texto de lançamento,
  sub-cards horizontais e placeholder para imagem.
{%- endcomment -%}
<div
  class="image-banner image-banner--{{ section.settings.height }}"
  data-section-id="{{ section.id }}"
  {% if section.settings.image != blank %}style="--banner-image-position: {{ section.settings.image.presentation.focal_point | default: 'center center' }}; --banner-image-ratio: {{ section.settings.image.aspect_ratio }};"{% endif %}
>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 3000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'image-banner__image',
        widths: '600, 900, 1200, 1600, 2000, 3000',
        sizes: '100vw',
        alt: section.settings.image.alt | default: section.settings.heading | escape
    }}
  {%- else -%}
    <div class="image-banner__image image-banner__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="image-banner__content image-banner__content--{{ section.settings.text_alignment }}">
    <div class="image-banner__box">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="image-banner__heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}
            <div class="image-banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div class="image-banner__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link | default: '#' }}" class="button image-banner__btn">{{ block.settings.button_label | escape }}</a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a href="{{ block.settings.button_link_2 | default: '#' }}" class="button button--secondary image-banner__btn">{{ block.settings.button_label_2 | escape }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Mini cards row at bottom {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="image-banner__cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'mini_card' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="image-banner__mini-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 300 | image_tag: class: 'image-banner__mini-img', loading: 'eager', widths: '150,200,300' }}
            {%- else -%}
              <div class="image-banner__mini-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <span class="image-banner__mini-title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<style>
  .image-banner {
    position: relative;
    display: flex;
    width: 100%;
    max-width: none;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    border-radius: 0 0 24px 24px;
    background: linear-gradient(135deg, #C62828 0%, #E53935 40%, #FF7043 100%);
  }
  .image-banner--small { min-height: 280px; }
  .image-banner--medium { min-height: 380px; }
  .image-banner--large { min-height: 520px; }

  .image-banner__image {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--banner-image-position, center center);
    z-index: 0;
  }
  .image-banner__placeholder {
    background: linear-gradient(135deg, #C62828 0%, #E53935 40%, #FF7043 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-banner__placeholder .placeholder-svg {
    width: 50%;
    max-width: 300px;
    opacity: 0.3;
  }

  .image-banner__content {
    position: relative;
    z-index: 2;
    padding: 40px 32px;
  }
  .image-banner__content--left { text-align: left; }
  .image-banner__content--center { text-align: center; }
  .image-banner__content--right { text-align: right; }
  .image-banner__box {
    max-width: 550px;
  }
  .image-banner__content--center .image-banner__box {
    margin: 0 auto;
  }
  .image-banner__content--right .image-banner__box {
    margin-left: auto;
  }
  .image-banner__heading {
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #ffffff;
    margin-bottom: 12px;
    text-shadow: 0 2px 16px rgba(0,0,0,0.25);
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .image-banner__text {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    color: rgba(255,255,255,0.9);
    margin-bottom: 20px;
    text-shadow: 0 1px 8px rgba(0,0,0,0.2);
  }
  .image-banner__buttons { display: flex; gap: 12px; flex-wrap: wrap; }
  .image-banner__content--center .image-banner__buttons { justify-content: center; }
  .image-banner__btn {
    background: #E8A817;
    border-color: #E8A817;
    color: #0B1D3A;
    font-weight: 700;
    border-radius: 8px;
  }
  .image-banner__btn:hover { opacity: 0.9; }

  .image-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.08);
    z-index: 1;
    pointer-events: none;
  }

  /* Mini cards row */
  .image-banner__cards {
    position: relative;
    z-index: 3;
    display: flex;
    gap: 12px;
    padding: 0 32px 24px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .image-banner__cards::-webkit-scrollbar { display: none; }
  .image-banner__mini-card {
    flex: 0 0 140px;
    background: rgba(0,0,0,0.25);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    padding: 10px;
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: background 0.2s;
  }
  .image-banner__mini-card:hover {
    background: rgba(0,0,0,0.4);
  }
  .image-banner__mini-img {
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
  }
  .image-banner__mini-placeholder {
    width: 100%;
    height: 80px;
    border-radius: 8px;
    background: rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-banner__mini-title {
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
  }

  @media screen and (max-width: 1000px) {
    .image-banner {
      min-height: 0;
      aspect-ratio: var(--banner-image-ratio, 16 / 9);
    }
    .image-banner__image {
      object-fit: contain;
      object-position: center;
    }
    .image-banner__heading { font-size: clamp(1.5rem, 5vw, 2rem); }
    .image-banner__content--right,
    .image-banner__content--left { text-align: center; }
    .image-banner__content { padding: 24px 16px; }
    .image-banner__cards { padding: 0 16px 16px; }
  }

  @media screen and (min-width: 1001px) {
    #shopify-section-{{ section.id }} {
      width: 100%;
      max-width: none;
    }
    #shopify-section-{{ section.id }} .image-banner__image {
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.image_banner.name",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.image_banner.settings.image.label" },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "small", "label": "t:sections.image_banner.settings.height.options__1.label" },
        { "value": "medium", "label": "t:sections.image_banner.settings.height.options__2.label" },
        { "value": "large", "label": "t:sections.image_banner.settings.height.options__3.label" }
      ],
      "default": "medium",
      "label": "t:sections.image_banner.settings.height.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "t:sections.image_banner.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.image_banner.settings.text_alignment.options__2.label" },
        { "value": "right", "label": "t:sections.image_banner.settings.text_alignment.options__3.label" }
      ],
      "default": "left",
      "label": "t:sections.image_banner.settings.text_alignment.label"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image_banner.blocks.heading.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "default": "LANÇAMENTO 2026", "label": "t:sections.image_banner.blocks.heading.settings.heading.label" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image_banner.blocks.text.name",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Rumo às estrelas — tudo que você precisa para conquistar medalhas.</p>", "label": "t:sections.image_banner.blocks.text.settings.text.label" }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.image_banner.blocks.button.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "default": "Shop now", "label": "t:sections.image_banner.blocks.button.settings.button_label.label" },
        { "type": "url", "id": "button_link", "label": "t:sections.image_banner.blocks.button.settings.button_link.label" },
        { "type": "text", "id": "button_label_2", "label": "t:sections.image_banner.blocks.button.settings.button_label_2.label" },
        { "type": "url", "id": "button_link_2", "label": "t:sections.image_banner.blocks.button.settings.button_link_2.label" }
      ]
    },
    {
      "type": "mini_card",
      "name": "Mini card",
      "settings": [
        { "type": "text", "id": "title", "default": "Rumo às estrelas", "label": "Título" },
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_banner.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
