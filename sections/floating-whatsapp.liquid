{% liquid
  assign whatsapp_phone = section.settings.phone | strip
  assign whatsapp_phone = whatsapp_phone | remove: ' ' | remove: '+' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
  assign whatsapp_message = section.settings.message | strip | url_encode
  assign icon_alt = section.settings.icon.alt

  if icon_alt == blank
    assign icon_alt = 'general.whatsapp.icon_alt' | t
  endif
%}

{% if section.settings.enabled and whatsapp_phone != blank %}
  <a
    class="floating-whatsapp"
    href="https://wa.me/{{ whatsapp_phone }}{% if whatsapp_message != blank %}?text={{ whatsapp_message }}{% endif %}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'general.whatsapp.open_chat' | t }}"
    style="--floating-whatsapp-size: {{ section.settings.size }}px; --floating-whatsapp-bottom: {{ section.settings.bottom_offset }}px; --floating-whatsapp-right: {{ section.settings.right_offset }}px; --floating-whatsapp-background: {{ section.settings.background_color }};"
  >
    {% if section.settings.icon != blank %}
      {{
        section.settings.icon
        | image_url: width: 240
        | image_tag:
          class: 'floating-whatsapp__image',
          widths: '48, 64, 80, 96, 120, 160, 240',
          sizes: '80px',
          loading: 'eager',
          alt: icon_alt
      }}
    {% else %}
      <svg class="floating-whatsapp__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M16.05 3A12.88 12.88 0 0 0 5.01 22.52L3.2 29l6.64-1.74A12.98 12.98 0 1 0 16.05 3Zm0 23.76a10.7 10.7 0 0 1-5.46-1.49l-.39-.23-3.94 1.03 1.05-3.83-.25-.4a10.71 10.71 0 1 1 8.99 4.92Zm5.88-8.03c-.32-.16-1.9-.94-2.2-1.05-.29-.11-.5-.16-.71.16-.21.32-.82 1.05-1 1.26-.19.22-.37.24-.69.08-.32-.16-1.36-.5-2.59-1.6a9.73 9.73 0 0 1-1.79-2.23c-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.54-.71-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.08-1.11 2.64 0 1.56 1.14 3.07 1.3 3.28.16.21 2.24 3.42 5.42 4.8.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.9-.78 2.17-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z"/>
      </svg>
    {% endif %}
  </a>
{% endif %}

{% stylesheet %}
  .floating-whatsapp {
    position: fixed;
    right: calc(var(--floating-whatsapp-right) + env(safe-area-inset-right));
    bottom: calc(var(--floating-whatsapp-bottom) + env(safe-area-inset-bottom));
    z-index: 180;
    display: grid;
    width: var(--floating-whatsapp-size);
    height: var(--floating-whatsapp-size);
    place-items: center;
    overflow: hidden;
    color: #ffffff;
    background: var(--floating-whatsapp-background);
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(11, 29, 58, 0.24);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .floating-whatsapp:hover {
    color: #ffffff;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 30px rgba(11, 29, 58, 0.3);
  }

  .floating-whatsapp:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .floating-whatsapp__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: inherit;
  }

  .floating-whatsapp__icon {
    width: 58%;
    height: 58%;
  }

  @media screen and (max-width: 1000px) {
    .floating-whatsapp {
      width: min(var(--floating-whatsapp-size), 60px);
      height: min(var(--floating-whatsapp-size), 60px);
    }

    body:has(.product__mobile-cta.is-visible) .floating-whatsapp {
      bottom: calc(var(--floating-whatsapp-bottom) + env(safe-area-inset-bottom) + 76px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WhatsApp flutuante",
  "tag": "div",
  "class": "floating-whatsapp-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Mostrar botão",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Número do WhatsApp",
      "info": "Informe apenas DDI, DDD e número. Exemplo: 5591999999999"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Mensagem inicial",
      "default": "Olá! Gostaria de mais informações."
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Imagem ou ícone",
      "info": "Se nenhuma imagem for selecionada, o ícone padrão do WhatsApp será exibido."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#25D366"
    },
    {
      "type": "range",
      "id": "size",
      "min": 48,
      "max": 88,
      "step": 4,
      "unit": "px",
      "label": "Tamanho",
      "default": 64
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Distância da parte inferior",
      "default": 24
    },
    {
      "type": "range",
      "id": "right_offset",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Distância da lateral direita",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "WhatsApp flutuante"
    }
  ]
}
{% endschema %}
