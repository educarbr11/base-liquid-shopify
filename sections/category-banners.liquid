{%- comment -%}
  ============================================================
  CATEGORY BANNERS
  ============================================================
  Seção para exibir uma lista de categorias como imagens, 
  na proporção de 540x220, totalmente configurável via admin.
{%- endcomment -%}

<div class="category-banners" data-section-id="{{ section.id }}" style="--columns-desktop: {{ section.settings.columns_desktop }};">
  {%- if section.settings.title != blank -%}
    <h2 class="category-banners__heading">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="category-banners__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="category-banner-item" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          {{
            block.settings.image
            | image_url: width: 1080
            | image_tag:
              loading: 'lazy',
              class: 'category-banner-item__image',
              widths: '270, 540, 1080',
              alt: block.settings.image.alt | default: section.settings.title | escape
          }}
        {%- else -%}
          <div class="category-banner-item__placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

<style>
  .category-banners {
    padding: 40px 24px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .category-banners__heading {
    font-size: var(--f5, 2rem);
    margin-bottom: 32px;
    text-align: center;
    color: var(--text-color, #0B1D3A);
    font-weight: 800; /* Matching common theme styles */
    text-transform: uppercase;
  }
  .category-banners__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop, 2), 1fr);
    gap: 24px;
    width: 100%;
  }
  .category-banner-item {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 54 / 22; /* Proporção de 540x220 solicitada */
    border-radius: 12px;
    overflow: hidden;
    background: #f4f4f4;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .category-banner-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .category-banner-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .category-banner-item__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e0e0e0;
  }
  .category-banner-item__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 80px;
    opacity: 0.5;
  }
  
  @media screen and (max-width: 768px) {
    .category-banners {
      padding: 32px 16px;
    }
    .category-banners__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .category-banner-item {
      aspect-ratio: auto;
      padding-bottom: 40.74%; /* Mantendo a proporção (220/540) no padding para alguns browsers antigos ou como fallback se o conteúdo crescer, mas aspect-ratio nativamente já faz isso perfeitamente. */
    }
    .category-banner-item__image,
    .category-banner-item__placeholder {
      position: absolute;
      top: 0;
      left: 0;
    }
  }
  @supports (aspect-ratio: 54 / 22) {
    .category-banner-item {
      padding-bottom: 0 !important;
    }
    .category-banner-item__image,
    .category-banner-item__placeholder {
      position: static !important;
    }
  }
</style>

{% schema %}
{
  "name": "Category Banners",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Categorias",
      "label": "Título da Seção",
      "info": "Título ajustável para a listagem."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Colunas no Desktop"
    }
  ],
  "blocks": [
    {
      "type": "category_banner",
      "name": "Banner de Categoria",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem da Categoria",
          "info": "Proporção recomendada: 540 x 220 pixels"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link de Direcionamento",
          "info": "Define o link ao clicar na imagem."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Banners",
      "blocks": [
        { "type": "category_banner" },
        { "type": "category_banner" }
      ]
    }
  ]
}
{% endschema %}
