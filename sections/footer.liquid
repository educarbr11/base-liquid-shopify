{%- comment -%}
  ============================================================
  FOOTER — rodapé escuro do site
  ============================================================
  Footer dark com: Logo+Contato, Nossos Links, Envio e pagamento.
  Design consistente com sidebar (dark blue #0B1D3A).
{%- endcomment -%}
<footer class="footer" data-section-id="{{ section.id }}">
  <div class="footer__top">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__block footer__block--brand" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {%- assign logo_height = 150 | divided_by: block.settings.logo.aspect_ratio | round -%}
              {{
                block.settings.logo
                | image_url: width: 400
                | image_tag:
                  class: 'footer__logo',
                  widths: '150, 300, 400',
                  width: 150,
                  height: logo_height,
                  alt: shop.name | escape
              }}
            {%- else -%}
              <p class="footer__brand-name">{{ shop.name }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}

            <div class="footer__contact">
              <h3 class="footer__contact-title">Contato</h3>
              <div class="footer__contact-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
                <span>Whats App</span>
              </div>
              <div class="footer__contact-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                <span>Call Us</span>
              </div>
            </div>
          </div>

        {%- when 'menu' -%}
          <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__menu" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer__link">
                      <span class="footer__link-bullet">›</span>
                      {{ link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {% render 'newsletter-form', block: block %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-left">
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="footer__bottom-center">
      {%- if section.settings.show_social -%}
        <ul class="footer__social" role="list">
          {%- if settings.social_instagram_link != blank -%}
            <li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>
          {%- endif -%}
          {%- if settings.social_linkedin_link != blank -%}
            <li><a href="{{ settings.social_linkedin_link }}" aria-label="LinkedIn" rel="noopener" target="_blank">{% render 'icon', name: 'linkedin' %}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="footer__bottom-right">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} – Todos os Direitos reservados
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0B1D3A;
    color: #ffffff;
    margin-top: 0;
  }
  .footer__top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 36px;
    padding: 40px 32px;
  }
  .footer__logo {
    display: block;
    height: auto;
    max-width: 120px;
    margin-bottom: 16px;
  }
  .footer__brand-name {
    font-family: var(--font-heading-family);
    font-size: var(--f4);
    font-weight: 700;
    margin-bottom: 12px;
  }

  /* Contact */
  .footer__contact {
    margin-top: 16px;
  }
  .footer__contact-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 10px;
  }
  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.75);
    margin-bottom: 6px;
  }
  .footer__contact-item svg {
    flex-shrink: 0;
    color: rgba(255,255,255,0.5);
  }

  .footer__heading {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .footer__menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 0;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s;
  }
  .footer__link:hover {
    color: #E8A817;
  }
  .footer__link-bullet {
    color: rgba(255,255,255,0.35);
    font-size: 1rem;
    line-height: 1;
  }
  .footer__text {
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 20px 32px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .footer__bottom-left,
  .footer__bottom-center,
  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .footer__payment {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .footer__payment-icon {
    width: 38px;
    height: 24px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    padding: 2px;
  }
  .footer__social {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__social a {
    color: rgba(255,255,255,0.7);
    display: inline-flex;
    transition: color 0.2s;
  }
  .footer__social a:hover { color: #E8A817; }
  .footer__copyright {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }

  @media screen and (max-width: 1000px) {
    .footer__top {
      padding: 32px 20px;
      gap: 28px;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "t:sections.footer.blocks.brand.settings.logo.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.brand.settings.text.label" }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "heading", "default": "Nossos Links", "label": "t:sections.footer.blocks.menu.settings.heading.label" },
        { "type": "link_list", "id": "menu", "default": "footer", "label": "t:sections.footer.blocks.menu.settings.menu.label" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.text.settings.heading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text.label" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "default": "Subscribe to our newsletter", "label": "t:sections.footer.blocks.newsletter.settings.heading.label" }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_social", "default": true, "label": "t:sections.footer.settings.show_social.label" },
    { "type": "checkbox", "id": "show_payment_icons", "default": true, "label": "t:sections.footer.settings.show_payment_icons.label" },
    { "type": "checkbox", "id": "enable_localization", "default": true, "label": "t:sections.footer.settings.enable_localization.label" }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
