{%- comment -%}
  ============================================================
  COLLECTION LIST — grade de categorias estilo card
  ============================================================
  Mostra categorias como cards horizontais com imagem de fundo
  e label por cima (LIVROS, KITS DE ROBÓTICA, etc).
{%- endcomment -%}
<div class="collection-list" data-section-id="{{ section.id }}" style="--grid-columns: {{ section.settings.columns_desktop }};">
  {%- if section.settings.heading != blank -%}
    <h2 class="collection-list__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="collection-list__grid">
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      <a href="{{ collection.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
        <div class="collection-card__media">
          {%- if collection.featured_image -%}
            {{
              collection.featured_image
              | image_url: width: 720
              | image_tag:
                loading: 'lazy',
                class: 'collection-card__image',
                widths: '360, 540, 720',
                sizes: '(min-width: 1000px) 30vw, 80vw',
                alt: collection.title | escape
            }}
          {%- else -%}
            <div class="collection-card__placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
          {%- endif -%}
          <div class="collection-card__overlay"></div>
          <h3 class="collection-card__title">{{ collection.title | default: 'Coleção' }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

<style>
  .collection-list {
    padding: 40px 24px;
  }
  .collection-list__heading {
    font-size: var(--f5);
    margin-bottom: 20px;
    text-align: center;
  }
  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 3), 1fr);
    gap: 20px;
  }
  .collection-card {
    display: block;
    text-decoration: none;
    color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .collection-card__media {
    position: relative;
    width: 100%;
    padding-bottom: 75%;
    overflow: hidden;
    background: linear-gradient(135deg, #0B1D3A 0%, #1a3a6a 100%);
  }
  .collection-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11,29,58,0.7) 0%, rgba(11,29,58,0.1) 100%);
    z-index: 1;
  }
  .collection-card__title {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 2;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  @media screen and (max-width: 1000px) {
    .collection-list__grid {
      grid-template-columns: 1fr;
    }
    .collection-list {
      padding: 24px 16px;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "default": "Coleções", "label": "t:sections.collection_list.settings.heading.label" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 3, "label": "t:sections.collection_list.settings.columns_desktop.label" }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection_list.blocks.featured_collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection_list.blocks.featured_collection.settings.collection.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}
