{%- comment -%}
  Página editorial de categorias. Somente coleções escolhidas nos
  blocos são exibidas, agrupadas na ordem pedagógica definida.
{%- endcomment -%}

<div class="list-collections page-width" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h1 class="list-collections__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- assign category_groups = 'featured|Lançamentos e Oportunidades,educacao_infantil|Educação Infantil,fundamental_i|Fundamental I,fundamental_ii|Fundamental II,paradidatico|Paradidático' | split: ',' -%}

  <div class="list-collections__groups">
    {%- for group_item in category_groups -%}
      {%- assign group_data = group_item | split: '|' -%}
      {%- assign group_key = group_data[0] -%}
      {%- assign group_title = group_data[1] -%}
      {%- assign visible_cards = 0 -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' and block.settings.group == group_key and block.settings.collection != blank -%}
          {%- assign visible_cards = visible_cards | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if visible_cards > 0 -%}
        <section class="list-collections__group" aria-labelledby="CategoryGroup-{{ section.id }}-{{ group_key }}">
          <h2 class="list-collections__group-title" id="CategoryGroup-{{ section.id }}-{{ group_key }}">{{ group_title }}</h2>
          <ul class="list-collections__grid" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection_card' and block.settings.group == group_key and block.settings.collection != blank -%}
                {%- assign category_collection = block.settings.collection -%}
                {%- assign collection_title = block.settings.title | default: category_collection.title -%}
                {%- assign collection_image = block.settings.image -%}
                {%- if collection_image == blank -%}
                  {%- assign collection_image = category_collection.featured_image -%}
                {%- endif -%}
                {%- if collection_image == blank -%}
                  {%- assign collection_image = category_collection.products.first.featured_image -%}
                {%- endif -%}

                <li class="list-collections__item" {{ block.shopify_attributes }}>
                  <a href="{{ category_collection.url }}" class="list-collections__link">
                    <div class="list-collections__media">
                      {%- if collection_image != blank -%}
                        {{
                          collection_image
                          | image_url: width: 1600
                          | image_tag:
                            loading: 'lazy',
                            widths: '320, 480, 640, 800, 1200, 1600',
                            sizes: '(min-width: 1200px) 580px, (min-width: 901px) calc((100vw - 72px) / 2), (min-width: 601px) calc((100vw - 64px) / 2), calc(100vw - 48px)',
                            class: 'list-collections__image',
                            alt: collection_title | escape
                        }}
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'list-collections__image placeholder-svg' }}
                      {%- endif -%}
                    </div>
                    <h3 class="list-collections__title">{{ collection_title | escape }}</h3>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background: linear-gradient(180deg, var(--color-background-contrast, #f2f3f8) 0, var(--color-background, #fff) 320px);
  }
  #shopify-section-{{ section.id }} .list-collections {
    margin-top: 0; margin-bottom: 0; padding-top: 32px; padding-bottom: max(56px, var(--spacing-sections, 40px));
  }
  #shopify-section-{{ section.id }} .list-collections__heading {
    margin: 0 0 32px; color: var(--color-text, #0B1D3A); font-family: 'Bungee', sans-serif;
    font-size: var(--f6); font-weight: 400; text-align: center;
  }
  #shopify-section-{{ section.id }} .list-collections__groups {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch;
  }
  #shopify-section-{{ section.id }} .list-collections__group {
    min-width: 0; padding: 20px; background: color-mix(in srgb, var(--color-background, #fff) 94%, transparent);
    border: 1px solid var(--color-border, #d9dde5); border-radius: 24px;
    box-shadow: 0 10px 30px rgba(11, 29, 58, .07);
  }
  #shopify-section-{{ section.id }} .list-collections__group:last-child:nth-child(odd) {
    grid-column: 1 / -1; width: calc(50% - 12px); justify-self: center;
  }
  #shopify-section-{{ section.id }} .list-collections__group-title {
    margin: 0 0 16px; color: var(--color-text, #0B1D3A); font-family: 'Bungee', sans-serif;
    font-size: clamp(1rem, 1.7vw, 1.25rem); font-weight: 400; line-height: 1.25;
    display: flex; align-items: center; gap: 10px;
  }
  #shopify-section-{{ section.id }} .list-collections__group-title::before {
    content: ''; width: 8px; height: 24px; flex: 0 0 auto; border-radius: 999px;
    background: var(--color-secondary, #E8A817);
  }
  #shopify-section-{{ section.id }} .list-collections__grid {
    display: flex; flex-direction: column; align-items: stretch; width: 100%; gap: 14px;
    margin: 0; padding: 0; list-style: none;
  }
  #shopify-section-{{ section.id }} .list-collections__item {
    overflow: hidden; background: var(--color-background, #fff); border: 1px solid var(--color-border, #c2c2c2);
    width: 100%; max-width: none; min-width: 0; flex: 0 0 auto; border-radius: 18px;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  #shopify-section-{{ section.id }} .list-collections__item:hover {
    border-color: var(--color-secondary, #E8A817); box-shadow: 0 10px 28px rgba(11, 29, 58, .12); transform: translateY(-4px);
  }
  #shopify-section-{{ section.id }} .list-collections__link {
    position: relative; display: block; height: 100%; color: inherit; text-decoration: none;
  }
  #shopify-section-{{ section.id }} .list-collections__media {
    position: relative; width: 100%; aspect-ratio: 16 / 7; overflow: hidden;
    background-color: var(--color-background-contrast, #f2f3f8); border-radius: 18px 18px 0 0;
  }
  #shopify-section-{{ section.id }} .list-collections__media::after {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(90deg, rgba(4, 39, 87, .58) 0%, rgba(4, 39, 87, .24) 32%, rgba(4, 39, 87, .06) 54%, transparent 72%);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .list-collections__image {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; filter: none;
  }
  #shopify-section-{{ section.id }} .list-collections__title {
    position: absolute; right: 18px; bottom: 16px; left: 18px; z-index: 2; max-width: 14ch; margin: 0;
    color: #fff; font-family: 'Bungee', sans-serif; font-size: var(--f2); font-weight: 400; line-height: 1.25;
    overflow-wrap: anywhere; text-align: left;
    text-shadow: 0 2px 6px rgba(4, 39, 87, .95), 0 0 18px rgba(4, 39, 87, .6);
  }
  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .list-collections__groups { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .list-collections__group:last-child:nth-child(odd) {
      grid-column: auto; width: 100%; justify-self: stretch;
    }
  }
  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .list-collections { padding-top: 24px; padding-bottom: 40px; }
    #shopify-section-{{ section.id }} .list-collections__heading { margin-bottom: 24px; font-size: clamp(1.45rem, 8vw, 2rem); }
    #shopify-section-{{ section.id }} .list-collections__groups { gap: 16px; }
    #shopify-section-{{ section.id }} .list-collections__group { padding: 14px; border-radius: 20px; }
    #shopify-section-{{ section.id }} .list-collections__group-title { margin-bottom: 12px; }
    #shopify-section-{{ section.id }} .list-collections__grid { gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .list-collections__item { transition: none; }
  }
</style>

{% schema %}
{
  "name": "Categorias organizadas",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "default": "Encontrar por categoria", "label": "Título" }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Banner personalizado", "info": "Recomendado: 1600 x 700 px (proporção 16:7). Se vazio, usa a imagem da coleção ou do primeiro produto." },
        { "type": "text", "id": "title", "label": "Título alternativo", "info": "Se vazio, usa o título da coleção." },
        {
          "type": "select", "id": "group", "label": "Grupo", "default": "educacao_infantil",
          "options": [
            { "value": "featured", "label": "Lançamentos e Oportunidades" },
            { "value": "educacao_infantil", "label": "Educação Infantil" },
            { "value": "fundamental_i", "label": "Fundamental I" },
            { "value": "fundamental_ii", "label": "Fundamental II" },
            { "value": "paradidatico", "label": "Paradidático" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
